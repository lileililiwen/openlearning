<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <!-- Coverage configuration for `dotnet test --collect:"XPlat Code Coverage"`.
       OpenCover XML is consumed by SonarCloud (sonar.cs.opencover.reportsPaths)
       and by the coverage-gates change. -->
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>opencover</Format>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
