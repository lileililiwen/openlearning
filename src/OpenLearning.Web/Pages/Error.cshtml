@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<div class="text-center py-5">
    <h1 class="display-6 fw-bold text-danger">Something went wrong</h1>
    <p class="lead">An error occurred while processing your request.</p>
    @if (Model.ShowRequestId)
    {
        <p class="text-muted">
            <small>Request ID: <code>@Model.RequestId</code></small>
        </p>
    }
    <a class="btn btn-primary" asp-page="/Index">Back to catalog</a>
</div>
