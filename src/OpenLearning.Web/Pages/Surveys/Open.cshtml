@page
@model OpenLearning.Web.Pages.Surveys.OpenModel
@{
    ViewData["Title"] = "Open surveys";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="/Index">Catalog</a></li>
        <li class="breadcrumb-item active">Open surveys</li>
    </ol>
</nav>

<h1 class="h4 mb-3">Open surveys</h1>

@if (Model.Available.Count == 0)
{
    <div class="alert alert-info">No open surveys right now.</div>
}
else
{
    <div class="list-group">
        @foreach (var survey in Model.Available)
        {
            <div class="list-group-item d-flex justify-content-between align-items-center">
                <div>
                    <strong>@survey.Title</strong>
                    @if (survey.IsAnonymous)
                    {
                        <span class="badge bg-secondary ms-2">Anonymous</span>
                    }
                    <div class="small text-muted">@survey.Description</div>
                    <div class="small text-muted">
                        Closes: @(survey.ClosesAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "no close date")
                    </div>
                </div>
                @if (Model.Responded.Contains(survey.Id))
                {
                    <span class="badge bg-success">Responded</span>
                }
                else
                {
                    <a class="btn btn-primary btn-sm" asp-page="/Surveys/Take" asp-route-id="@survey.Id"
                       asp-route-courseId="@Model.CourseId">Respond</a>
                }
            </div>
        }
    </div>
}
