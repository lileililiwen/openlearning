@page
@model OpenLearning.Web.Pages.Distributor.IndexModel
@{
    ViewData["Title"] = "Distributor Dashboard";
}

<div class="d-flex justify-content-between align-items-end mb-4">
    <div>
        <h1 class="h3 mb-1">Distributor Dashboard</h1>
        <p class="text-muted mb-0">Share courses and earn commissions.</p>
    </div>
    <a class="btn btn-primary" asp-page="Links">Share links</a>
</div>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-@(TempData["MessageType"] ?? "success") alert-dismissible fade show" role="alert">
        @message
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card text-center shadow-sm h-100">
            <div class="card-body">
                <div class="h2 mb-0">@Model.Available.ToString("C")</div>
                <div class="text-muted small">Available balance</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center shadow-sm h-100">
            <div class="card-body">
                <div class="h2 mb-0">@Model.TotalEarned.ToString("C")</div>
                <div class="text-muted small">Total earned</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center shadow-sm h-100">
            <div class="card-body">
                <div class="h2 mb-0">@Model.RecentCommissions.Count</div>
                <div class="text-muted small">Recent commissions</div>
            </div>
        </div>
    </div>
</div>

<h2 class="h5 mb-3">Recent commissions</h2>
@if (Model.RecentCommissions.Count == 0)
{
    <div class="alert alert-info">
        No commissions yet. <a asp-page="Links">Create a share link</a> and promote a course to start earning.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle bg-white shadow-sm rounded">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Amount</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var commission in Model.RecentCommissions)
                {
                    <tr>
                        <td>@commission.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</td>
                        <td>@commission.Amount.ToString("C")</td>
                        <td>
                            @if (commission.Status == CommissionStatus.Pending)
                            {
                                <span class="badge bg-secondary">Pending</span>
                            }
                            else if (commission.Status == CommissionStatus.Available)
                            {
                                <span class="badge bg-success">Available</span>
                            }
                            else if (commission.Status == CommissionStatus.Paid)
                            {
                                <span class="badge bg-primary">Paid</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Reversed</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
