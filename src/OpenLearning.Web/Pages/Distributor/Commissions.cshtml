@page
@model OpenLearning.Web.Pages.Distributor.CommissionsModel
@{
    ViewData["Title"] = "Commissions";
}

<h1 class="h3 mb-4">Commissions</h1>

<form method="get" class="card shadow-sm mb-4">
    <div class="card-body d-flex gap-2">
        <select asp-for="Status" class="form-select form-select-sm" style="max-width: 220px">
            <option value="">All statuses</option>
            @foreach (var value in Enum.GetValues<CommissionStatus>())
            {
                <option value="@value">@value</option>
            }
        </select>
        <button type="submit" class="btn btn-sm btn-primary">Filter</button>
        <a class="btn btn-sm btn-outline-secondary" asp-page="Commissions">Reset</a>
    </div>
</form>

@if (Model.Commissions.Count == 0)
{
    <div class="alert alert-info">No commissions match this filter.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle bg-white shadow-sm rounded">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Order</th>
                    <th>Amount</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var commission in Model.Commissions)
                {
                    <tr>
                        <td>@commission.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                        <td>#@commission.OrderId</td>
                        <td>@commission.Amount.ToString("C")</td>
                        <td>
                            @if (commission.Status == CommissionStatus.Pending)
                            {
                                <span class="badge bg-secondary">Pending</span>
                            }
                            else if (commission.Status == CommissionStatus.Available)
                            {
                                <span class="badge bg-success">Available</span>
                            }
                            else if (commission.Status == CommissionStatus.Paid)
                            {
                                <span class="badge bg-primary">Paid</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Reversed</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
