@page
@model OpenLearning.Web.Pages.Admin.Reports.RevenueModel
@{
    ViewData["Title"] = "Admin · Revenue Report";
}

<div class="d-flex justify-content-between align-items-end mb-4">
    <div>
        <h1 class="h3 mb-1">Revenue report</h1>
        <p class="text-muted mb-0">Paid orders grouped by course and instructor.</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary" asp-page="/Admin/Reports/Enrollments">Enrollments</a>
        <a class="btn btn-outline-primary" asp-page="/Admin/Reports/Users">Users</a>
    </div>
</div>

<form method="get" class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small text-muted mb-1">From</label>
                <input type="date" name="from" value="@(Model.From?.ToString("yyyy-MM-dd") ?? "")" class="form-control" />
            </div>
            <div class="col-md-3">
                <label class="form-label small text-muted mb-1">To</label>
                <input type="date" name="to" value="@(Model.To?.ToString("yyyy-MM-dd") ?? "")" class="form-control" />
            </div>
            <div class="col-md-6">
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Filter</button>
                    <a class="btn btn-outline-secondary" asp-page="/Admin/Reports/Revenue">All time</a>
                    <a class="btn btn-outline-success ms-auto" asp-page="/Admin/Reports/Revenue" asp-page-handler="Export"
                       asp-route-from="@(Model.From?.ToString("yyyy-MM-dd") ?? "")" asp-route-to="@(Model.To?.ToString("yyyy-MM-dd") ?? "")">Export CSV</a>
                </div>
            </div>
        </div>
    </div>
</form>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-4">
            <div class="col-md-4">
                <div class="text-muted small">Total revenue</div>
                <div class="h3 mb-0">@Model.TotalRevenue.ToString("C")</div>
            </div>
            <div class="col-md-4">
                <div class="text-muted small">Paid orders</div>
                <div class="h3 mb-0">@Model.TotalOrders</div>
            </div>
            <div class="col-md-4">
                <div class="text-muted small">Courses with revenue</div>
                <div class="h3 mb-0">@Model.Rows.Count</div>
            </div>
        </div>
    </div>
</div>

@if (Model.Rows.Count == 0)
{
    <div class="alert alert-info">No paid orders in the selected period.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle bg-white shadow-sm rounded">
            <thead>
                <tr>
                    <th>Course</th>
                    <th>Instructor</th>
                    <th class="text-end">Orders</th>
                    <th class="text-end">Revenue</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Rows)
                {
                    <tr>
                        <td><a asp-page="/Courses/Details" asp-route-id="@row.CourseId" class="fw-semibold text-decoration-none">@row.CourseTitle</a></td>
                        <td>@row.InstructorName</td>
                        <td class="text-end">@row.OrderCount</td>
                        <td class="text-end fw-semibold">@row.Revenue.ToString("C")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="table-light">
                    <td colspan="2" class="fw-semibold">Total</td>
                    <td class="text-end fw-semibold">@Model.TotalOrders</td>
                    <td class="text-end fw-semibold">@Model.TotalRevenue.ToString("C")</td>
                </tr>
            </tfoot>
        </table>
    </div>
}
