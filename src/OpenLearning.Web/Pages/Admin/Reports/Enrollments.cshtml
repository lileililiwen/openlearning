@page
@model OpenLearning.Web.Pages.Admin.Reports.EnrollmentsModel
@{
    ViewData["Title"] = "Admin · Enrollments Report";
}

<div class="d-flex justify-content-between align-items-end mb-4">
    <div>
        <h1 class="h3 mb-1">Enrollments report</h1>
        <p class="text-muted mb-0">Enrollments over time and by course.</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary" asp-page="/Admin/Reports/Revenue">Revenue</a>
        <a class="btn btn-outline-primary" asp-page="/Admin/Reports/Users">Users</a>
    </div>
</div>

<form method="get" class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small text-muted mb-1">From</label>
                <input type="date" name="from" value="@(Model.From?.ToString("yyyy-MM-dd") ?? "")" class="form-control" />
            </div>
            <div class="col-md-3">
                <label class="form-label small text-muted mb-1">To</label>
                <input type="date" name="to" value="@(Model.To?.ToString("yyyy-MM-dd") ?? "")" class="form-control" />
            </div>
            <div class="col-md-6">
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Filter</button>
                    <a class="btn btn-outline-secondary" asp-page="/Admin/Reports/Enrollments">All time</a>
                    <a class="btn btn-outline-success ms-auto" asp-page="/Admin/Reports/Enrollments" asp-page-handler="Export"
                       asp-route-from="@(Model.From?.ToString("yyyy-MM-dd") ?? "")" asp-route-to="@(Model.To?.ToString("yyyy-MM-dd") ?? "")">Export CSV</a>
                </div>
            </div>
        </div>
    </div>
</form>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="text-muted small">Total enrollments</div>
        <div class="h3 mb-0">@Model.Total</div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white"><strong>Enrollments over time</strong></div>
            <div class="card-body">
                @if (Model.OverTime.Count == 0)
                {
                    <p class="text-muted mb-0">No enrollments in the selected period.</p>
                }
                else
                {
                    <table class="table table-sm align-middle mb-0">
                        <tbody>
                            @foreach (var item in Model.OverTime)
                            {
                                var width = Model.MaxDayCount == 0 ? 0 : (int)Math.Round(item.Count * 100.0 / Model.MaxDayCount);
                                <tr>
                                    <td class="text-muted small" style="width: 130px">@item.Day.ToString("yyyy-MM-dd")</td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="progress flex-grow-1" style="height: 14px">
                                                <div class="progress-bar" role="progressbar" style="width: @width%"></div>
                                            </div>
                                            <span class="small text-muted" style="width: 40px">@item.Count</span>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white"><strong>By course</strong></div>
            <div class="card-body">
                @if (Model.ByCourse.Count == 0)
                {
                    <p class="text-muted mb-0">No enrollments in the selected period.</p>
                }
                else
                {
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Course</th>
                                <th class="text-end">Enrollments</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.ByCourse)
                            {
                                <tr>
                                    <td><a asp-page="/Courses/Details" asp-route-id="@row.CourseId" class="text-decoration-none">@row.CourseTitle</a></td>
                                    <td class="text-end">@row.Count</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>
