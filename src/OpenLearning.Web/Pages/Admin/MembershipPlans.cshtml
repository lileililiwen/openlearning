@page
@model OpenLearning.Web.Pages.Admin.MembershipPlansModel
@{
    ViewData["Title"] = "Admin · Membership Plans";
}

<div class="d-flex justify-content-between align-items-end mb-4">
    <div>
        <h1 class="h3 mb-1">Admin — Membership Plans</h1>
        <p class="text-muted mb-0">Define the membership plans students can purchase.</p>
    </div>
    <a class="btn btn-outline-primary" asp-page="/Admin/Index">Back to dashboard</a>
</div>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-@(TempData["MessageType"] ?? "success") alert-dismissible fade show" role="alert">
        @message
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <h2 class="h5 mb-3">New plan</h2>
                <form method="post" asp-page-handler="Create">
                    <div class="mb-3">
                        <label for="name" class="form-label small">Name</label>
                        <input id="name" name="name" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label for="description" class="form-label small">Description</label>
                        <textarea id="description" name="description" rows="3" class="form-control"></textarea>
                    </div>
                    <div class="mb-3">
                        <label for="price" class="form-label small">Price</label>
                        <input id="price" name="price" type="number" step="0.01" min="0" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label for="durationDays" class="form-label small">Duration (days)</label>
                        <input id="durationDays" name="durationDays" type="number" min="1" class="form-control" />
                    </div>
                    <button type="submit" class="btn btn-primary">Create plan</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body">
                <h2 class="h5 mb-3">Plans (@Model.Plans.Count)</h2>
                <ul class="list-group list-group-flush">
                    @foreach (var plan in Model.Plans)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-start">
                            <div>
                                <strong>@plan.Name</strong>
                                <span class="text-muted small"> · @plan.Price.ToString("C") / @plan.DurationDays days</span>
                                @if (!plan.IsActive)
                                {
                                    <span class="badge bg-secondary ms-2">Inactive</span>
                                }
                                <div class="small text-muted">@plan.Description</div>
                            </div>
                            <form method="post" asp-page-handler="Toggle" asp-route-id="@plan.Id">
                                <button type="submit" class="btn btn-sm btn-outline-@(plan.IsActive ? "warning" : "success")">
                                    @(plan.IsActive ? "Deactivate" : "Activate")
                                </button>
                            </form>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>
