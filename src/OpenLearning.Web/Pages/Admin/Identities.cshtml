@page
@model OpenLearning.Web.Pages.Admin.IdentitiesModel
@{
    ViewData["Title"] = "Admin · Identity Review";
}

<div class="d-flex justify-content-between align-items-end mb-4">
    <div>
        <h1 class="h3 mb-1">Admin — Identity Verification</h1>
        <p class="text-muted mb-0">Review real-name verification requests.</p>
    </div>
    <a class="btn btn-outline-primary" asp-page="/Admin/Users">Back to users</a>
</div>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-@(TempData["MessageType"] ?? "success") alert-dismissible fade show" role="alert">
        @message
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<h2 class="h4 mb-3">Pending (@Model.Pending.Count)</h2>
@if (Model.Pending.Count == 0)
{
    <div class="alert alert-info mb-4">No pending verification requests.</div>
}
else
{
    <div class="row g-4 mb-4">
        @foreach (var user in Model.Pending)
        {
            <div class="col-lg-6">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h5 class="card-title mb-1">@(user.RealName ?? user.DisplayName)</h5>
                        <div class="text-muted small mb-3">
                            @user.Email · @user.IdType · submitted @user.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                        </div>
                        @if (!string.IsNullOrWhiteSpace(user.VerificationDocumentUrl))
                        {
                            <p class="mb-2">
                                <a href="@user.VerificationDocumentUrl" target="_blank" rel="noopener">View submitted document</a>
                            </p>
                        }
                        <form method="post" asp-page-handler="Review" asp-route-id="@user.Id" class="mb-2">
                            <div class="input-group">
                                <input name="note" class="form-control" placeholder="Optional note" />
                                <button class="btn btn-success" name="action" value="approve" type="submit">Approve</button>
                                <button class="btn btn-outline-danger" name="action" value="reject" type="submit">Reject</button>
                            </div>
                        </form>
                        <div class="text-muted small">ID hash: <code>@(user.IdNumberHash is string hash ? hash[..Math.Min(16, hash.Length)] + "…" : "—")</code></div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<h2 class="h4 mb-3">Reviewed</h2>
@if (Model.Reviewed.Count == 0)
{
    <div class="alert alert-info">No reviewed requests yet.</div>
}
else
{
    <div class="card shadow-sm">
        <ul class="list-group list-group-flush">
            @foreach (var user in Model.Reviewed)
            {
                <li class="list-group-item d-flex justify-content-between align-items-start">
                    <div>
                        <strong>@(user.RealName ?? user.DisplayName)</strong>
                        <span class="text-muted small"> · @user.Email</span>
                        <div class="small text-muted">
                            @(user.IdentityStatus == OpenLearning.Auth.Models.IdentityStatus.Verified ? "Approved" : "Rejected")
                            @if (user.VerifiedAt is DateTime when)
                            {
                                <text>· @when.ToString("yyyy-MM-dd")</text>
                            }
                            @if (!string.IsNullOrWhiteSpace(user.VerificationNote))
                            {
                                <text>· Note: @user.VerificationNote</text>
                            }
                        </div>
                    </div>
                </li>
            }
        </ul>
    </div>
}
