@page
@model OpenLearning.Web.Pages.Admin.AsyncIO.IndexModel
@{
    ViewData["Title"] = "Admin · Async Jobs";
}

<h1 class="h3 mb-4">Admin — Async Jobs</h1>

<form method="get" class="card shadow-sm mb-4">
    <div class="card-body d-flex gap-2">
        <input name="Kind" class="form-control form-control-sm" style="max-width: 200px" placeholder="Kind…" value="@Model.Kind" />
        <select name="Status" class="form-select form-select-sm" style="max-width: 180px">
            <option value="">All statuses</option>
            @foreach (var value in Enum.GetValues<AsyncIOJobStatus>())
            {
                <option value="@value" selected="@(Model.Status == value)">@value</option>
            }
        </select>
        <button type="submit" class="btn btn-sm btn-primary">Filter</button>
    </div>
</form>

@if (Model.Jobs.Count == 0)
{
    <div class="alert alert-info">No async jobs match this filter.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle bg-white shadow-sm rounded">
            <thead>
                <tr>
                    <th>Kind</th>
                    <th>Owner</th>
                    <th>Status</th>
                    <th>Rows</th>
                    <th>Created</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var job in Model.Jobs)
                {
                    <tr>
                        <td><a asp-page="/AsyncIO/Detail" asp-route-id="@job.Id">@job.Kind</a></td>
                        <td>@job.UserId</td>
                        <td>@job.Status</td>
                        <td>@job.SuccessRows/@job.TotalRows</td>
                        <td>@job.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
