@page
@model OpenLearning.Web.Pages.Admin.LtiModel
@{ ViewData["Title"] = "Admin · LTI 1.3"; }
<div class="d-flex justify-content-between mb-4"><div><h1 class="h3">LTI 1.3 integrations</h1><p class="text-muted">Registrations, deployments, context mappings, capabilities, signing keys, diagnostics, and audit.</p></div><form method="post" asp-page-handler="RotateKey"><button class="btn btn-outline-primary">Rotate OpenLearning key</button></form></div>
@if (TempData["Message"] is string message) { <div class="alert alert-@(TempData["MessageType"])">@message</div> }
<div class="card mb-4"><div class="card-body"><h2 class="h5">New registration</h2><form method="post" asp-page-handler="Create" class="row g-2">
<div class="col-md-4"><input class="form-control" name="name" placeholder="Name" required maxlength="200" /></div><div class="col-md-4"><input class="form-control" name="issuer" placeholder="HTTPS issuer" required /></div><div class="col-md-4"><input class="form-control" name="clientId" placeholder="Client ID" required /></div>
<div class="col-md-4"><input class="form-control" name="authorizationEndpoint" placeholder="HTTPS authorization endpoint" required /></div><div class="col-md-4"><input class="form-control" name="jwksUrl" placeholder="HTTPS JWKS URL" required /></div><div class="col-md-4"><input class="form-control" name="tokenEndpoint" placeholder="Optional HTTPS token endpoint" /></div>
<div class="col-12"><label class="me-3"><input type="checkbox" name="deepLinking" value="true" /> Deep Linking</label><label class="me-3"><input type="checkbox" name="nrps" value="true" /> NRPS</label><label><input type="checkbox" name="ags" value="true" /> AGS</label></div><div><button class="btn btn-primary">Create</button></div></form></div></div>
@foreach (var registration in Model.Registrations) { <div class="card mb-3"><div class="card-body"><div class="d-flex justify-content-between"><h2 class="h5">@registration.Name <small class="text-muted">@registration.Issuer</small></h2>@if (registration.RevokedAt is null) { <form method="post" asp-page-handler="Revoke" asp-route-id="@registration.Id"><button class="btn btn-sm btn-outline-danger">Revoke</button></form> } else { <span class="badge bg-danger">Revoked</span> }</div><p>Client: <code>@registration.ClientId</code> · Capabilities: @registration.Capabilities</p>
<form method="post" asp-page-handler="Deployment" class="d-flex gap-2 mb-2"><input type="hidden" name="registrationId" value="@registration.Id"/><input class="form-control" name="deploymentId" placeholder="Deployment ID" required maxlength="300"/><button class="btn btn-outline-primary">Add deployment</button></form>
@foreach (var deployment in registration.Deployments) { <div class="border rounded p-2 mb-2"><strong>Deployment:</strong> @deployment.DeploymentId
<form method="post" asp-page-handler="Mapping" class="row g-2 mt-1"><input type="hidden" name="deploymentId" value="@deployment.Id"/><div class="col-md-5"><input class="form-control" name="contextId" placeholder="External context ID" required /></div><div class="col-md-5"><select class="form-select" name="courseId">@foreach (var course in Model.Courses) { <option value="@course.Id">@course.Title</option> }</select></div><div class="col-md-2"><button class="btn btn-outline-primary">Map</button></div></form>
<ul>@foreach (var mapping in deployment.ContextMappings) { <li><code>@mapping.ExternalContextId</code> → course @mapping.CourseId</li> }</ul></div> }</div></div> }
<div class="card"><div class="card-body"><h2 class="h5">Recent audit</h2><table class="table table-sm"><thead><tr><th>Time</th><th>Event</th><th>Result</th><th>Detail</th></tr></thead><tbody>@foreach (var item in Model.Audit) { <tr><td>@item.CreatedAt</td><td>@item.EventType</td><td>@(item.Succeeded ? "OK" : "Denied")</td><td>@item.Detail</td></tr> }</tbody></table></div></div>
