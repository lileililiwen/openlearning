@page
@model OpenLearning.Web.Pages.Admin.OrganizationsModel
@{ ViewData["Title"] = "Organizations"; }
<h1>Organizations</h1>
<form method="post" asp-page-handler="Create" class="row g-2 mb-4"><div class="col"><input name="name" maxlength="200" required class="form-control" placeholder="Name" /></div><div class="col"><input name="slug" maxlength="100" required pattern="[a-z0-9-]+" class="form-control" placeholder="slug" /></div><div class="col-auto"><button class="btn btn-primary">Create</button></div></form>
<table class="table"><thead><tr><th>Name</th><th>Slug</th><th>Status</th><th>Configuration</th><th></th></tr></thead><tbody>@foreach(var item in Model.Items){<tr><td>@item.Name</td><td>@item.Slug</td><td>@item.Status</td><td><form method="post" asp-page-handler="Configure" class="d-flex gap-1"><input type="hidden" name="id" value="@item.Id"/><input name="name" value="@item.Name" class="form-control form-control-sm"/><input name="primaryColor" value="@item.PrimaryColor" class="form-control form-control-sm"/><input name="maximumDepartmentDepth" value="@item.MaximumDepartmentDepth" type="number" min="1" max="20" class="form-control form-control-sm"/><button class="btn btn-sm btn-outline-primary">Save</button></form></td><td><form method="post" asp-page-handler="Status"><input type="hidden" name="id" value="@item.Id"/><input type="hidden" name="status" value="@(item.Status == OrganizationStatus.Active ? OrganizationStatus.Suspended : OrganizationStatus.Active)"/><button class="btn btn-sm @(item.Status == OrganizationStatus.Active ? "btn-danger" : "btn-success")">@(item.Status == OrganizationStatus.Active ? "Suspend" : "Reactivate")</button></form></td></tr>}</tbody></table>
@foreach(var item in Model.Items){<details class="mb-2"><summary>@item.Name audit history</summary><ul>@foreach(var audit in Model.Audits[item.Id]){<li>@audit.CreatedAt.ToLocalTime(): @audit.Action — @audit.Details</li>}</ul></details>}
