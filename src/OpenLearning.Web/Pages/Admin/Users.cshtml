@page
@model OpenLearning.Web.Pages.Admin.UsersModel
@{
    ViewData["Title"] = "Admin · Users";
}

<div class="d-flex justify-content-between align-items-end mb-4">
    <div>
        <h1 class="h3 mb-1">Admin — Users</h1>
        <p class="text-muted mb-0">Search users, manage roles, and suspend accounts.</p>
    </div>
    <a class="btn btn-outline-primary" asp-page="/Admin/InstructorApplications">Instructor applications</a>
</div>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-@(TempData["MessageType"] ?? "success") alert-dismissible fade show" role="alert">
        @message
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<form method="get" class="d-flex gap-2 mb-3" style="max-width: 480px">
    <input type="text" name="Search" value="@Model.Search" class="form-control" placeholder="Search by name or email" />
    <button type="submit" class="btn btn-primary">Search</button>
</form>

@if (Model.Users.Count == 0)
{
    <div class="alert alert-info">No users found.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle bg-white shadow-sm rounded">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Roles</th>
                    <th>Status</th>
                    <th>Joined</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.Users)
                {
                    <tr>
                        <td>
                            <a asp-page="/Admin/UserDetail" asp-route-id="@user.UserId" asp-route-search="@Model.Search" class="fw-semibold">@user.DisplayName</a>
                        </td>
                        <td>@user.Email</td>
                        <td>
                            @if (user.Roles.Count == 0)
                            {
                                <span class="text-muted small">—</span>
                            }
                            else
                            {
                                foreach (var role in user.Roles)
                                {
                                    <span class="badge bg-secondary">@role</span>
                                }
                            }
                        </td>
                        <td>
                            @if (user.IsSuspended)
                            {
                                <span class="badge bg-danger">Suspended</span>
                            }
                            else
                            {
                                <span class="badge badge-published">Active</span>
                            }
                        </td>
                        <td>@user.CreatedAt.ToString("yyyy-MM-dd")</td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-1">
                                <a class="btn btn-sm btn-outline-primary" asp-page="/Admin/UserDetail" asp-route-id="@user.UserId" asp-route-search="@Model.Search">View</a>
                                @if (user.Roles.Contains(Roles.Instructor))
                                {
                                    <form method="post" asp-page-handler="ToggleInstructor" asp-route-userId="@user.UserId" asp-route-add="false" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-outline-secondary">Remove instructor</button>
                                    </form>
                                }
                                else
                                {
                                    <form method="post" asp-page-handler="ToggleInstructor" asp-route-userId="@user.UserId" asp-route-add="true" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-outline-secondary">Make instructor</button>
                                    </form>
                                }
                                @if (user.IsSuspended)
                                {
                                    <form method="post" asp-page-handler="SetSuspended" asp-route-userId="@user.UserId" asp-route-suspended="false" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-outline-success">Reactivate</button>
                                    </form>
                                }
                                else
                                {
                                    <form method="post" asp-page-handler="SetSuspended" asp-route-userId="@user.UserId" asp-route-suspended="true" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Suspend</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
