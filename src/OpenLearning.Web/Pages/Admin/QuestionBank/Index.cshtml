@page
@model OpenLearning.Web.Pages.Admin.QuestionBank.IndexModel
@{
    ViewData["Title"] = "题库管理";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">题库管理</h1>
    <span class="d-inline-flex gap-2">
        <a class="btn btn-sm btn-outline-primary" asp-page="/Admin/QuestionBank/Import">Excel导入</a>
        <a class="btn btn-sm btn-outline-secondary" asp-page="/Admin/QuestionBank/Export">导出</a>
        <a class="btn btn-sm btn-primary" asp-page="/Admin/QuestionBank/Create">新增题库题目</a>
    </span>
</div>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @message
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<form method="get" class="row g-2 mb-3">
    <div class="col-md-4">
        <input name="Topic" value="@Model.Topic" class="form-control form-control-sm" placeholder="主题/标签" />
    </div>
    <div class="col-md-5">
        <input name="Text" value="@Model.Text" class="form-control form-control-sm" placeholder="题干关键词" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-sm btn-outline-primary">搜索</button>
    </div>
</form>

<div class="card shadow-sm">
    <div class="card-header bg-white"><strong>共 @Model.Total 道题目</strong></div>
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>主题</th>
                    <th>题干</th>
                    <th>类型</th>
                    <th>分值</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var q in Model.Items)
                {
                    <tr>
                        <td>@(q.BankTopic ?? "—")</td>
                        <td>@q.Text</td>
                        <td>@q.QuestionType</td>
                        <td>@q.Points</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" asp-page="/Admin/QuestionBank/Edit" asp-route-id="@q.Id">编辑</a>
                            <form method="post" asp-page-handler="Archive" asp-route-id="@q.Id" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-danger">归档</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
