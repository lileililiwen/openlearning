@page
@model OpenLearning.Web.Pages.Admin.RefundsModel
@{
    ViewData["Title"] = "Refund Requests";
}

<div class="d-flex justify-content-between align-items-end mb-4">
    <div>
        <h1 class="h3 mb-1">Refund Requests</h1>
        <p class="text-muted mb-0">Approve or reject student refund requests.</p>
    </div>
    <a class="btn btn-outline-secondary" asp-page="/Admin/Index">Admin home</a>
</div>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-@(TempData["MessageType"] ?? "success") alert-dismissible fade show" role="alert">
        @message
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (Model.Requests.Count == 0)
{
    <div class="alert alert-info">No pending refund requests.</div>
}
else
{
    @foreach (var order in Model.Requests)
    {
        <div class="card shadow-sm mb-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                        <strong>Order #@order.Id — @(order.Course?.Title ?? $"Course #{order.CourseId}")</strong>
                        <div class="text-muted small">
                            @(order.Student?.DisplayName ?? order.StudentId) · @order.Amount.ToString("C") · requested @(order.RefundRequestedAt?.ToString("yyyy-MM-dd HH:mm"))
                        </div>
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <form method="post" asp-page-handler="Approve" asp-route-id="@order.Id"
                          onsubmit="return confirm('Approve this refund? The instructor ledger will be debited.');">
                        <button type="submit" class="btn btn-success btn-sm">Approve refund</button>
                    </form>
                    <form method="post" asp-page-handler="Reject" asp-route-id="@order.Id"
                          onsubmit="return confirm('Reject this refund request?');">
                        <button type="submit" class="btn btn-outline-danger btn-sm">Reject</button>
                    </form>
                </div>
            </div>
        </div>
    }
}
