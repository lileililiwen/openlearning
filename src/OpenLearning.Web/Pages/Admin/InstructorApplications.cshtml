@page
@model OpenLearning.Web.Pages.Admin.InstructorApplicationsModel
@{
    ViewData["Title"] = "Admin · Instructor Applications";
}

<div class="d-flex justify-content-between align-items-end mb-4">
    <div>
        <h1 class="h3 mb-1">Admin — Instructor Applications</h1>
        <p class="text-muted mb-0">Approve or reject requests to become an instructor.</p>
    </div>
    <a class="btn btn-outline-primary" asp-page="/Admin/Users">Back to users</a>
</div>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-@(TempData["MessageType"] ?? "success") alert-dismissible fade show" role="alert">
        @message
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<h2 class="h4 mb-3">Pending (@Model.Pending.Count)</h2>
@if (Model.Pending.Count == 0)
{
    <div class="alert alert-info mb-4">No pending applications.</div>
}
else
{
    <div class="row g-4 mb-4">
        @foreach (var app in Model.Pending)
        {
            <div class="col-lg-6">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h5 class="card-title mb-1">
                            @(app.User?.DisplayName ?? "Unknown user")
                        </h5>
                        <div class="text-muted small mb-3">@app.User?.Email · submitted @app.SubmittedAt.ToString("yyyy-MM-dd HH:mm")</div>
                        <p class="card-text">@app.Motivation</p>
                        <div class="d-flex gap-2">
                            <form method="post" asp-page-handler="Approve" asp-route-id="@app.Id" class="d-inline">
                                <button type="submit" class="btn btn-success">Approve</button>
                            </form>
                            <form method="post" asp-page-handler="Reject" asp-route-id="@app.Id" class="d-flex flex-grow-1 gap-2">
                                <input type="text" name="reason" class="form-control" placeholder="Reason (optional)" maxlength="1000" />
                                <button type="submit" class="btn btn-outline-danger">Reject</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<h2 class="h4 mb-3">Recently reviewed</h2>
@if (Model.Reviewed.Count == 0)
{
    <div class="alert alert-info">No applications have been reviewed yet.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle bg-white shadow-sm rounded">
            <thead>
                <tr>
                    <th>Applicant</th>
                    <th>Decision</th>
                    <th>Reason</th>
                    <th>Reviewed</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var app in Model.Reviewed)
                {
                    <tr>
                        <td>@(app.User?.DisplayName ?? "Unknown user")</td>
                        <td>
                            @if (app.Status == InstructorApplicationStatus.Approved)
                            {
                                <span class="badge badge-published">Approved</span>
                            }
                            else
                            {
                                <span class="badge badge-draft">Rejected</span>
                            }
                        </td>
                        <td class="text-muted">@(app.RejectionReason ?? "—")</td>
                        <td class="text-muted">@(app.ReviewedAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
