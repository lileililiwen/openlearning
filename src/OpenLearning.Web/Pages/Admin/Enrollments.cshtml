@page
@model OpenLearning.Web.Pages.Admin.EnrollmentsModel
@{
    ViewData["Title"] = "Admin · Enrollments";
}

<h1 class="h3 mb-4">Admin — Enrollments</h1>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-@(TempData["MessageType"] ?? "success") alert-dismissible fade show" role="alert">
        @message
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<form method="get" class="card shadow-sm mb-4">
    <div class="card-body d-flex flex-wrap gap-2">
        <select asp-for="CourseId" class="form-select form-select-sm" style="max-width: 280px">
            <option value="">All courses</option>
            @foreach (var course in Model.Courses)
            {
                <option value="@course.Id">@course.Title</option>
            }
        </select>
        <input asp-for="Search" class="form-control form-control-sm" style="max-width: 260px"
               placeholder="Search student name or email…" />
        <button type="submit" class="btn btn-sm btn-primary">Filter</button>
        <a class="btn btn-sm btn-outline-secondary" asp-page="Enrollments">Reset</a>
    </div>
</form>

@if (Model.Enrollments.Count == 0)
{
    <div class="alert alert-info">No enrollments match the filter.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle bg-white shadow-sm rounded">
            <thead>
                <tr>
                    <th>Student</th>
                    <th>Course</th>
                    <th>Enrolled</th>
                    <th>Expires</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var enrollment in Model.Enrollments)
                {
                    <tr class="@(enrollment.RevokedAt is not null ? "table-secondary" : "")">
                        <td>
                            @(enrollment.Student?.DisplayName ?? enrollment.StudentId)
                            <div class="text-muted small">@enrollment.Student?.Email</div>
                        </td>
                        <td>
                            <a asp-page="/Courses/Details" asp-route-id="@enrollment.CourseId">@enrollment.Course?.Title</a>
                        </td>
                        <td>@enrollment.EnrolledAt.ToLocalTime().ToString("yyyy-MM-dd")</td>
                        <td>@(enrollment.AccessExpiresAt?.ToLocalTime().ToString("yyyy-MM-dd") ?? "Unlimited")</td>
                        <td>
                            @if (enrollment.RevokedAt is not null)
                            {
                                <span class="badge bg-danger">Revoked</span>
                            }
                            else if (enrollment.AccessExpiresAt is DateTime expiresAt && expiresAt < DateTime.UtcNow)
                            {
                                <span class="badge bg-warning text-dark">Expired</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Active</span>
                            }
                        </td>
                        <td class="text-end">
                            @if (enrollment.RevokedAt is null)
                            {
                                <form method="post" asp-page-handler="Revoke" asp-route-id="@enrollment.Id" class="d-flex gap-2 justify-content-end">
                                    <input name="reason" class="form-control form-control-sm" style="max-width: 140px"
                                           placeholder="reason (e.g. refund)" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger"
                                            onclick="return confirm('Revoke this enrollment? History is preserved.');">Revoke</button>
                                </form>
                            }
                            else
                            {
                                <span class="text-muted small">@enrollment.RevokedReason</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
