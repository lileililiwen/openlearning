@page
@model OpenLearning.Web.Pages.Admin.CreditsModel
@{ ViewData["Title"] = "Credit and graduation administration"; }
<h1>Credit and graduation administration</h1>
<div class="row g-4">
<section class="col-lg-6"><h2 class="h4">Course credit rule</h2><form method="post" asp-page-handler="PublishRule">
<select name="courseId" class="form-select mb-2" required>@foreach(var c in Model.Courses){<option value="@c.Id">@c.Title</option>}</select>
<input name="amount" type="number" min="0.01" step="0.01" class="form-control mb-2" placeholder="Credits" required />
<select name="category" asp-items="Html.GetEnumSelectList<CreditCategory>()" class="form-select mb-2"></select><button class="btn btn-primary">Publish rule</button></form></section>
<section class="col-lg-6"><h2 class="h4">Publish program version</h2><form method="post" asp-page-handler="CreateProgram">
<input name="name" maxlength="200" class="form-control mb-2" placeholder="Program name" required /><input name="minTotalCredits" type="number" min="0" step="0.01" class="form-control mb-2" placeholder="Minimum total" required />
<input name="categoryMinimums" class="form-control mb-2" placeholder="Major:20,Elective:10" /><input name="requiredCourseIds" class="form-control mb-2" placeholder="Required course IDs: 1,2" />
<input name="creditExpiryDays" type="number" min="1" class="form-control mb-2" placeholder="Optional expiry days" /><button class="btn btn-primary">Publish version</button></form></section>
<section class="col-lg-6"><h2 class="h4">Assign learner</h2><form method="post" asp-page-handler="Assign"><select name="studentId" class="form-select mb-2">@foreach(var s in Model.Students){<option value="@s.Id">@s.Email</option>}</select><select name="programId" class="form-select mb-2">@foreach(var p in Model.Programs){<option value="@p.Id">@p.Name v@(p.Version)</option>}</select><button class="btn btn-primary">Assign</button></form></section>
<section class="col-lg-6"><h2 class="h4">Manual adjustment</h2><form method="post" asp-page-handler="Adjust"><select name="studentId" class="form-select mb-2">@foreach(var s in Model.Students){<option value="@s.Id">@s.Email</option>}</select><input name="amount" type="number" step="0.01" class="form-control mb-2" required /><select name="category" asp-items="Html.GetEnumSelectList<CreditCategory>()" class="form-select mb-2"></select><input name="reason" maxlength="1000" class="form-control mb-2" required placeholder="Reason"/><button class="btn btn-primary">Record adjustment</button></form></section>
<section class="col-lg-6"><h2 class="h4">Revoke award</h2><form method="post" asp-page-handler="Revoke"><input name="awardId" type="number" min="1" class="form-control mb-2" required placeholder="Award ID"/><input name="reason" maxlength="1000" class="form-control mb-2" required placeholder="Reason"/><button class="btn btn-danger">Record revocation</button></form></section>
<section class="col-lg-6"><h2 class="h4">Graduation decision</h2><form method="post" asp-page-handler="Graduate"><select name="studentId" class="form-select mb-2">@foreach(var s in Model.Students){<option value="@s.Id">@s.Email</option>}</select><select name="programId" class="form-select mb-2">@foreach(var p in Model.Programs){<option value="@p.Id">@p.Name v@(p.Version)</option>}</select><input name="notes" maxlength="2000" class="form-control mb-2" placeholder="Notes"/><button class="btn btn-success">Mark graduated</button></form></section>
</div>
<section class="mt-4"><h2 class="h4">Existing completion backfill</h2><a asp-page="Credits" asp-route-previewBackfill="true" class="btn btn-outline-secondary">Preview</a>
@if(Model.BackfillPreview.Count > 0){<ul class="mt-2">@foreach(var row in Model.BackfillPreview){<li>@row.Student.Email — @row.Course.Title</li>}</ul><form method="post" asp-page-handler="Backfill"><button class="btn btn-warning">Apply backfill</button></form>}</section>
