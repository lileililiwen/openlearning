@page
@model OpenLearning.Web.Pages.Admin.Distributors.IndexModel
@{
    ViewData["Title"] = "Admin · Distributors";
}

<h1 class="h3 mb-4">Admin — Distributors</h1>

@if (Model.Distributors.Count == 0)
{
    <div class="alert alert-info">No distributor profiles exist yet.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle bg-white shadow-sm rounded">
            <thead>
                <tr>
                    <th>Distributor</th>
                    <th>Active</th>
                    <th>Created</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var profile in Model.Distributors)
                {
                    <tr>
                        <td>
                            @(profile.User?.DisplayName ?? profile.UserId)
                            <div class="text-muted small">@profile.User?.Email</div>
                        </td>
                        <td>
                            @if (profile.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                        <td>@profile.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</td>
                        <td class="text-end">
                            <form method="post" asp-page-handler="Toggle" asp-route-userId="@profile.UserId">
                                <button type="submit" class="btn btn-sm btn-outline-secondary">
                                    @(profile.IsActive ? "Deactivate" : "Activate")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
