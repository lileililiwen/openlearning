@page
@model OpenLearning.Web.Pages.StudyTools.NotesModel
@{
    ViewData["Title"] = "My Notes";
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="card shadow-sm mb-4">
            <div class="card-body p-4">
                <h1 class="h4 mb-3">My Notes</h1>

                @if (Model.StatusMessage is string statusMessage)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @statusMessage
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @if (Model.Error is string error)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @error
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <!-- Filters -->
                <form method="get" class="row g-2 mb-4">
                    <div class="col-auto">
                        <select name="contextType" class="form-select form-select-sm">
                            <option value="">All contexts</option>
                            <option value="Course" selected="@(Model.FilterContextType == NoteContextType.Course)">Course</option>
                            <option value="Lesson" selected="@(Model.FilterContextType == NoteContextType.Lesson)">Lesson</option>
                            <option value="Resource" selected="@(Model.FilterContextType == NoteContextType.Resource)">Resource</option>
                        </select>
                    </div>
                    <div class="col-auto">
                        <input name="tag" value="@Model.FilterTag" class="form-control form-control-sm" placeholder="Tag filter" />
                    </div>
                    <div class="col-auto">
                        <input name="search" value="@Model.FilterSearch" class="form-control form-control-sm" placeholder="Search notes..." />
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-sm btn-primary">Filter</button>
                        <a asp-page="/StudyTools/Notes" class="btn btn-sm btn-outline-secondary">Clear</a>
                    </div>
                    <div class="col-auto ms-auto">
                        <a asp-page="/StudyTools/Notes" asp-route-export="true" class="btn btn-sm btn-outline-success">Export CSV</a>
                    </div>
                </form>

                <!-- Notes list -->
                @foreach (var note in Model.Notes)
                {
                    <div class="card mb-3">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <span class="badge bg-secondary me-1">@note.ContextType</span>
                                    <span class="text-muted small">#@note.ContextId</span>
                                    @if (note.MediaOffsetSeconds.HasValue)
                                    {
                                        <span class="text-muted small ms-2">@@ @note.MediaOffsetSeconds s</span>
                                    }
                                    @if (!string.IsNullOrEmpty(note.Tags))
                                    {
                                        <span class="text-muted small ms-2">Tags: @note.Tags</span>
                                    }
                                </div>
                                <span class="text-muted small">@note.UpdatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                            </div>
                            <hr class="my-2" />
                            <div class="note-body">@note.Body</div>
                            <div class="d-flex gap-2 mt-3">
                                <form method="post" asp-page-handler="Delete" asp-route-noteId="@note.Id">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            </div>
                        </div>
                    </div>
                }

                @if (Model.Notes.Count == 0)
                {
                    <p class="text-muted">No notes found.</p>
                }
            </div>
        </div>

        <!-- New Note Form -->
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h2 class="h5 mb-3">New Note</h2>
                <form method="post" asp-page-handler="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label asp-for="Input.ContextType" class="form-label">Context Type</label>
                            <select asp-for="Input.ContextType" class="form-select">
                                <option value="Course">Course</option>
                                <option value="Lesson">Lesson</option>
                                <option value="Resource">Resource</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Input.ContextId" class="form-label">Context ID</label>
                            <input asp-for="Input.ContextId" class="form-control" type="number" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Input.MediaOffsetSeconds" class="form-label">Media Offset (seconds)</label>
                            <input asp-for="Input.MediaOffsetSeconds" class="form-control" type="number" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.Tags" class="form-label">Tags (comma-separated)</label>
                        <input asp-for="Input.Tags" class="form-control" placeholder="e.g. review, exam-prep" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.Body" class="form-label">Note</label>
                        <textarea asp-for="Input.Body" class="form-control" rows="6" placeholder="Write your note here..." autofocus></textarea>
                        <span asp-validation-for="Input.Body" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn btn-primary">Create Note</button>
                </form>
            </div>
        </div>
    </div>
</div>
