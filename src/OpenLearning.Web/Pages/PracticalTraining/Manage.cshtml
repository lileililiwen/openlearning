@page
@model OpenLearning.Web.Pages.PracticalTraining.ManageModel
@{ ViewData["Title"] = "Practical training administration"; }
<h1>@ViewData["Title"]</h1>
<section><h2>Program</h2><form method="post" asp-page-handler="Program"><input name="title" placeholder="Title" required maxlength="200" /><input name="minimumHours" type="number" min="0.25" step="0.25" required /><input name="competencies" placeholder="Required competencies, comma separated" required /><button type="submit">Create</button></form></section>
<section><h2>Host</h2><form method="post" asp-page-handler="Host"><input name="name" placeholder="Host name" required maxlength="200" /><input name="email" type="email" placeholder="Contact email" maxlength="320" /><button type="submit">Create</button></form></section>
<section><h2>Placement</h2><form method="post" asp-page-handler="Placement"><select name="programId" required>@foreach (var p in Model.Programs) { <option value="@p.Id">@p.Title v@p.Version (@p.MinimumHours h)</option> }</select><select name="hostId" required>@foreach (var h in Model.Hosts) { <option value="@h.Id">@h.Name</option> }</select><input name="learnerId" placeholder="Learner user id" required /><input name="supervisorName" placeholder="Supervisor name" required /><input name="supervisorEmail" type="email" placeholder="Supervisor email" required /><input name="startsOn" type="date" required /><input name="endsOn" type="date" required /><button type="submit">Create</button></form></section>
<h2>Placements</h2>
<table><thead><tr><th>ID</th><th>Program / learner / host</th><th>Status</th><th>Actions</th></tr></thead><tbody>
@foreach (var p in Model.Placements) { <tr><td>@p.Id</td><td>@p.Program?.Title / @p.LearnerId / @p.Host?.Name</td><td>@p.Status</td><td><form method="post"><input type="hidden" name="id" value="@p.Id" /><button asp-page-handler="Activate">Activate</button><button asp-page-handler="Invite">Invite supervisor</button><button asp-page-handler="Revoke">Revoke supervisor</button><button asp-page-handler="Complete">Confirm completion</button></form><form method="post" asp-page-handler="Incident"><input type="hidden" name="id" value="@p.Id" /><select name="severity"><option value="Informational">Informational</option><option value="Blocking">Blocking</option></select><input name="summary" required maxlength="2000" placeholder="Incident" /><button>Record</button></form><form method="post" asp-page-handler="ResolveIncident"><input type="hidden" name="id" value="@p.Id" /><input name="incidentId" type="number" min="1" required placeholder="Incident ID" /><input name="resolution" required maxlength="2000" placeholder="Resolution" /><button>Resolve incident</button></form></td></tr> }
</tbody></table>
