@page
@model OpenLearning.Web.Pages.PracticalTraining.SupervisorModel
@{ ViewData["Title"] = "Placement supervision"; var token = Request.Query["token"].ToString(); }
<h1>@ViewData["Title"]</h1>
@if (Model.Placement is not null) { <p>@Model.Placement.Program?.Title at @Model.Placement.Host?.Name, @Model.Placement.StartsOn to @Model.Placement.EndsOn. Learner identifier and unrelated placement data are intentionally hidden.</p>
<h2>Submitted hours</h2>@foreach (var log in Model.Logs.Where(x => x.Status == OpenLearning.PracticalTraining.Models.PracticalLogStatus.Submitted)) { <form method="post" asp-page-handler="Review"><input type="hidden" name="token" value="@token" /><input type="hidden" name="placementId" value="@Model.Placement.Id" /><input type="hidden" name="logId" value="@log.Id" /><input type="hidden" name="concurrencyStamp" value="@log.ConcurrencyStamp" /><span>@log.StartedAt – @log.EndedAt: @log.Description</span><input name="note" maxlength="1000" /><button name="approve" value="true">Approve</button><button name="approve" value="false">Reject</button></form> }
<h2>Competencies</h2>@foreach (var item in Model.Competencies) { <form method="post" asp-page-handler="Competency"><input type="hidden" name="token" value="@token" /><input type="hidden" name="placementId" value="@Model.Placement.Id" /><input type="hidden" name="competencyId" value="@item.Id" /><span>@item.ProgramCompetency?.Name</span><select name="achieved"><option value="true">Achieved</option><option value="false">Not achieved</option></select><input name="evaluation" required maxlength="2000" /><button>Save</button></form> }
<h2>Final evaluation</h2><form method="post" asp-page-handler="Evaluation"><input type="hidden" name="token" value="@token" /><input type="hidden" name="placementId" value="@Model.Placement.Id" /><textarea name="summary" required maxlength="4000"></textarea><button>Submit</button></form> }
