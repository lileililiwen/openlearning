@page
@model OpenLearning.Web.Pages.Resources.PickerModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="zh">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>选择资源</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light">
    <div class="container-fluid p-3">
        <form method="get" class="d-flex gap-2 mb-3">
            <input type="hidden" name="target" value="@Model.Target" />
            <select name="Purpose" class="form-select form-select-sm" style="width: auto">
                <option value="">全部类型</option>
                <option value="@OpenLearning.Storage.Models.FilePurpose.Image">图片</option>
                <option value="@OpenLearning.Storage.Models.FilePurpose.Video">视频</option>
                <option value="@OpenLearning.Storage.Models.FilePurpose.Document">文档</option>
            </select>
            <input type="text" name="Search" value="@Model.Search" class="form-control form-control-sm" placeholder="按文件名搜索" />
            <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-search"></i> 筛选</button>
            <a class="btn btn-sm btn-outline-secondary" asp-page="/Resources/Picker" asp-route-target="@Model.Target" title="清除筛选条件"><i class="bi bi-x-circle"></i></a>
        </form>

        @if (Model.Items.Count == 0)
        {
            <div class="alert alert-info">暂无资源。请先在 <a href="/Resources" target="_blank">资源中心</a> 上传。</div>
        }
        else
        {
            <div class="row g-2">
                @foreach (var item in Model.Items)
                {
                    <div class="col-4 col-md-3">
                        <div class="card h-100">
                            <div class="position-relative resource-thumb">
                                @if (item.File.Purpose == OpenLearning.Storage.Models.FilePurpose.Image)
                                {
                                    <img src="@item.Url" alt="@item.File.OriginalName" class="card-img-top" style="height: 90px; object-fit: cover" onerror="resourceThumbBroken(this)" />
                                    <div class="resource-thumb-fallback"><i class="bi bi-image fs-3"></i></div>
                                }
                                else if (item.File.Purpose == OpenLearning.Storage.Models.FilePurpose.Video)
                                {
                                    <video class="card-img-top" style="height: 90px; object-fit: cover" src="@item.Url" muted preload="metadata" onerror="resourceThumbBroken(this)"></video>
                                    <div class="resource-thumb-fallback"><i class="bi bi-film fs-3"></i></div>
                                }
                                else
                                {
                                    <div class="resource-thumb-fallback d-flex"><i class="bi bi-file-earmark-text fs-3"></i></div>
                                }
                                @if (item.File.IsShared)
                                {
                                    <span class="badge bg-primary position-absolute top-0 start-0 m-1" style="z-index: 3">共享</span>
                                }
                            </div>
                            <div class="card-body p-2">
                                <div class="small text-truncate" title="@item.File.OriginalName">@item.File.OriginalName</div>
                                <button type="button" class="btn btn-sm btn-primary w-100 mt-1" onclick="pickResource('@item.Url')">选择</button>
                            </div>
                        </div>
                    </div>
                }
            </div>
            @if (OpenLearning.Web.Pages.Resources.PickerModel.PageCount(Model.Total) > 1)
            {
                <nav class="mt-3">
                    <ul class="pagination pagination-sm mb-0">
                        @for (var p = 1; p <= OpenLearning.Web.Pages.Resources.PickerModel.PageCount(Model.Total); p++)
                        {
                            <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                                <a class="page-link" asp-page="/Resources/Picker" asp-route-pageNumber="@p" asp-route-purpose="@Model.Purpose" asp-route-search="@Model.Search" asp-route-target="@Model.Target">@p</a>
                            </li>
                        }
                    </ul>
                </nav>
            }
        }
    </div>
    <style>
        .resource-thumb-fallback {
            display: none;
            height: 90px;
            align-items: center;
            justify-content: center;
            background: #f8f9fa;
            color: #6c757d;
        }
        .resource-thumb-fallback.d-flex {
            display: flex;
        }
    </style>
    <script>
        function resourceThumbBroken(img) {
            img.style.display = 'none';
            var fallback = img.nextElementSibling;
            if (fallback) {
                fallback.style.display = 'flex';
            }
        }
        function pickResource(url) {
            var target = '@Html.Raw(Model.Target ?? string.Empty)';
            try {
                if (target && window.parent && window.parent.document) {
                    var input = window.parent.document.getElementById(target);
                    if (input) { input.value = url; }
                }
            } catch (e) { /* cross-origin or missing input */ }
            try {
                if (window.parent && typeof window.parent.closeResourcePicker === 'function') {
                    window.parent.closeResourcePicker();
                }
            } catch (e) { }
        }
    </script>
</body>
</html>
