@page
@model OpenLearning.Web.Pages.TA.RemindersModel
@{
    ViewData["Title"] = "班级提醒";
    var c = Model.ClassGroup!;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">@c.Name — 发送提醒</h1>
    <a class="btn btn-outline-secondary btn-sm" asp-page="/TA/Index">返回助教工作台</a>
</div>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-@(TempData["MessageType"] ?? "success") alert-dismissible fade show" role="alert">
        @message
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm" style="max-width: 640px">
    <div class="card-body">
        <form method="post">
            <div class="mb-3">
                <label class="form-label">提醒标题</label>
                <input name="title" class="form-control" required />
            </div>
            <div class="mb-3">
                <label class="form-label">提醒内容</label>
                <textarea name="body" class="form-control" rows="4" required></textarea>
            </div>
            <button type="submit" class="btn btn-primary">发送给班级学员</button>
        </form>
    </div>
</div>
