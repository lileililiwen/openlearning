@page
@model OpenLearning.Web.Pages.TA.RosterModel
@{
    ViewData["Title"] = "班级花名册";
    var c = Model.ClassGroup!;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">@c.Name — 花名册 (@Model.Rows.Count)</h1>
    <span class="d-inline-flex gap-2">
        <a class="btn btn-sm btn-outline-primary" asp-page="/TA/ClassImport" asp-route-classId="@c.Id">导入学生</a>
        <a class="btn btn-outline-secondary btn-sm" asp-page="/TA/Index">返回助教工作台</a>
    </span>
</div>

@if (Model.Rows.Count == 0)
{
    <div class="alert alert-info">该班级暂无学员。</div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>姓名</th>
                        <th>邮箱</th>
                        <th>加入时间</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            <td>@row.StudentName</td>
                            <td>@row.StudentEmail</td>
                            <td>@row.EnrolledAt.ToString("yyyy-MM-dd")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
