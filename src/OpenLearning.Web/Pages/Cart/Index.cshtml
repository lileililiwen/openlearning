@page
@model OpenLearning.Web.Pages.Cart.IndexModel
@{
    ViewData["Title"] = "Shopping Cart";
}

<div class="d-flex justify-content-between align-items-end mb-4">
    <div>
        <h1 class="h3 mb-1">Shopping Cart</h1>
        <p class="text-muted mb-0">Review your courses and check out together.</p>
    </div>
    <a class="btn btn-outline-primary" asp-page="/Index">Keep browsing</a>
</div>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-@(TempData["MessageType"] ?? "success") alert-dismissible fade show" role="alert">
        @message
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (Model.Items.Count == 0)
{
    <div class="alert alert-info">Your cart is empty.</div>
}
else
{
    <div class="row g-4">
        <div class="col-lg-8">
            @foreach (var item in Model.Items)
            {
                var course = item.Course;
                <div class="card shadow-sm mb-3">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <div>
                            <strong>@course?.Title</strong>
                            <div class="text-muted small">@(course?.Price is > 0 ? course!.Price!.Value.ToString("C") : "Free")</div>
                        </div>
                        <div class="d-flex gap-2 align-items-center">
                            @if (course is not null)
                            {
                                <a class="btn btn-sm btn-outline-secondary" asp-page="/Courses/Details" asp-route-id="@course.Id">View</a>
                            }
                            <form method="post" asp-page-handler="Remove" asp-route-courseId="@item.CourseId">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h2 class="h6 mb-3">Checkout</h2>
                    <div class="d-flex justify-content-between mb-1">
                        <span>Courses</span>
                        <strong>@Model.Items.Count</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-3">
                        <span>Subtotal</span>
                        <strong>@Model.Total.ToString("C")</strong>
                    </div>

                    <form method="post" asp-page-handler="Checkout">
                        <div class="mb-3">
                            <label class="form-label small" for="CouponCode">Coupon code</label>
                            <input name="CouponCode" id="CouponCode" class="form-control" placeholder="e.g. WELCOME10" value="@Model.CouponCode" />
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" name="UseBalance" id="UseBalance" value="true" checked="@Model.UseBalance" />
                            <label class="form-check-label small" for="UseBalance">Use balance (@Model.Balance.ToString("C"))</label>
                        </div>
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" name="UsePoints" id="UsePoints" value="true" checked="@Model.UsePoints" />
                            <label class="form-check-label small" for="UsePoints">Use points (@Model.Points pts — 100 pts = $1.00)</label>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Checkout</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}
