@page
@model OpenLearning.Web.Pages.LearningPaths.ManageModel
@{ ViewData["Title"] = "Learning path management"; }
<h1>Learning paths</h1>
@if (TempData["Message"] is string message) { <div class="alert alert-@(TempData["MessageType"] ?? "info")">@message</div> }
<form method="post" asp-page-handler="Create" class="card card-body mb-4">
  <h2 class="h5">New path</h2><input name="title" maxlength="200" required class="form-control mb-2" placeholder="Title" />
  <textarea name="description" maxlength="4000" class="form-control mb-2" placeholder="Description"></textarea>
  <button class="btn btn-primary">Create draft</button>
</form>
<div class="list-group mb-4">
@foreach (var path in Model.Paths) { <a class="list-group-item list-group-item-action" asp-route-id="@path.Id">@path.Title @(path.IsArchived ? "(archived)" : "")</a> }
</div>
@if (Model.Draft is not null) {
<section class="card card-body"><h2 class="h4">@Model.Draft.LearningPath!.Title — draft v@(Model.Draft.VersionNumber)</h2>
@foreach (var stage in Model.Draft.Stages.OrderBy(x => x.Position)) {
 <div class="border rounded p-3 mb-3"><h3 class="h5">@stage.Position. @stage.Title <small>(choose @stage.MinimumElectives electives)</small></h3>
 <ul>@foreach (var item in stage.Courses.OrderBy(x => x.Position)) { var c = Model.Courses.SingleOrDefault(x => x.Id == item.CourseId); <li>@(c?.Title ?? $"Course {item.CourseId}") — @(item.IsRequired ? "required" : "elective") @if(item.PrerequisiteCourseId is not null){<span>(requires course @item.PrerequisiteCourseId)</span>}</li> }</ul>
 <form method="post" asp-page-handler="Course" class="row g-2"><input type="hidden" name="id" value="@Model.Draft.LearningPathId"/><input type="hidden" name="stageId" value="@stage.Id"/>
  <div class="col"><select name="courseId" class="form-select" required>@foreach(var c in Model.Courses){<option value="@c.Id">@c.Title</option>}</select></div>
  <div class="col"><select name="prerequisiteCourseId" class="form-select"><option value="">No prerequisite</option>@foreach(var courseId in Model.Draft.Stages.SelectMany(x=>x.Courses).Select(x=>x.CourseId)){<option value="@courseId">Course @courseId</option>}</select></div>
  <div class="col-auto form-check"><input class="form-check-input" type="checkbox" name="isRequired" value="true" id="required-@stage.Id"/><label class="form-check-label" for="required-@stage.Id">Required</label></div><div class="col-auto"><button class="btn btn-outline-primary">Add course</button></div></form>
 </div> }
<form method="post" asp-page-handler="Stage" class="row g-2 mb-3"><input type="hidden" name="id" value="@Model.Draft.LearningPathId"/><div class="col"><input name="title" maxlength="200" required class="form-control" placeholder="Stage title"/></div><div class="col"><input name="minimumElectives" min="0" type="number" class="form-control" value="0"/></div><div class="col-auto"><button class="btn btn-outline-primary">Add stage</button></div></form>
<form method="post" asp-page-handler="Publish" class="d-inline"><input type="hidden" name="id" value="@Model.Draft.LearningPathId"/><button class="btn btn-success">Preview validation and publish</button></form>
<form method="post" asp-page-handler="Archive" class="d-inline"><input type="hidden" name="id" value="@Model.Draft.LearningPathId"/><button class="btn btn-outline-danger">Archive</button></form></section> }
