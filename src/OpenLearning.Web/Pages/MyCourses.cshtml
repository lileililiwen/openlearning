@page
@model OpenLearning.Web.Pages.MyCoursesModel
@inject IStringLocalizer<MyCoursesModel> Localizer
@{
    ViewData["Title"] = Localizer["My Courses"];
}

<h1 class="h3 mb-4">@Localizer["My Courses"]</h1>

@{
    var expiring = Model.Courses
        .Where(c => !c.IsRevoked && c.Enrollment.AccessExpiresAt is not null && c.DaysRemaining <= Model.GraceDays)
        .OrderBy(c => c.DaysRemaining)
        .ToList();
}
@if (expiring.Count > 0)
{
    <div class="alert alert-warning">
        <strong>@Localizer["Access expiring soon:"]</strong>
        @foreach (var item in expiring)
        {
            var course = item.Enrollment.Course!;
            if (item.IsExpired)
            {
                <div>@Localizer["Your access to \"{0}\" has expired and will be revoked in {1} days. Please renew.", course.Title, Model.GraceDays]
                    <a asp-page="/Courses/Details" asp-route-id="@course.Id">@Localizer["Renew"]</a>
                </div>
            }
            else
            {
                <div>@Localizer["Your access to \"{0}\" will be revoked in {1} days. Please renew.", course.Title, item.DaysRemaining]
                    <a asp-page="/Courses/Details" asp-route-id="@course.Id">@Localizer["Renew"]</a>
                </div>
            }
        }
    </div>
}

@if (Model.Courses.Count == 0)
{
    ViewData["StateMessage"] = Localizer["You are not enrolled in any courses yet."].Value;
    ViewData["StateActionText"] = Localizer["Browse the catalog"].Value;
    ViewData["StateActionUrl"] = Url.Page("/Index");
    <partial name="_StateEmpty" />
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var item in Model.Courses)
        {
            var course = item.Enrollment.Course!;
            <div class="col">
                <div class="card h-100 shadow-sm @(item.IsRevoked ? "opacity-75" : "")">
                    <div class="card-body">
                        <h5 class="card-title">
                            <a class="text-decoration-none" asp-page="/Courses/Details" asp-route-id="@course.Id">@course.Title</a>
                        </h5>
                        <h6 class="card-subtitle mb-2 text-muted">
                            @course.Category
                            @if (course.Instructor is not null)
                            {
                                <span>· by @course.Instructor.DisplayName</span>
                            }
                        </h6>
                        <p class="text-muted small mb-2">Enrolled @item.Enrollment.EnrolledAt.ToString("yyyy-MM-dd")</p>

                        @if (item.IsRevoked)
                        {
                            <span class="badge bg-danger mb-2">@Localizer["Access revoked"]</span>
                        }
                        else if (item.IsExpired)
                        {
                            <span class="badge bg-warning text-dark mb-2">@Localizer["Access expired — renew to continue"]</span>
                        }
                        else if (item.Enrollment.AccessExpiresAt is not null)
                        {
                            <span class="badge bg-info mb-2">@Localizer["Access until {0}", item.Enrollment.AccessExpiresAt.Value.ToLocalTime().ToString("yyyy-MM-dd")]</span>
                        }

                        <div class="d-flex justify-content-between small mb-1">
                            <span>@Localizer["Progress"]</span>
                            <span>@item.ProgressPercent%</span>
                        </div>
                        <div class="progress progress-thin mb-3" role="progressbar" aria-valuenow="@item.ProgressPercent" aria-valuemin="0" aria-valuemax="100" aria-label="@Localizer["Course progress"]">
                            <div class="progress-bar" style="width: @item.ProgressPercent%"></div>
                        </div>
                    </div>
                    <div class="card-footer bg-transparent d-flex gap-2">
                        @if (item.IsRevoked || item.IsExpired)
                        {
                            <a class="btn btn-sm btn-primary" asp-page="/Courses/Details" asp-route-id="@course.Id">@Localizer["Renew access"]</a>
                        }
                        else
                        {
                            @if (item.ResumeLessonId is { } resumeId)
                            {
                                <a class="btn btn-sm btn-primary" asp-page="/Courses/Lessons/View" asp-route-id="@resumeId">@Localizer["Continue"]</a>
                            }
                            else
                            {
                                <a class="btn btn-sm btn-primary" asp-page="/Courses/Details" asp-route-id="@course.Id">@Localizer["Continue"]</a>
                            }
                        }
                        <form method="post" asp-page-handler="Withdraw" asp-route-id="@course.Id"
                              class="ms-auto"
                              confirm="@Localizer["Withdraw from this course? Your progress will be lost."]">
                            <button type="submit" class="btn btn-sm btn-outline-danger">@Localizer["Withdraw"]</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}
