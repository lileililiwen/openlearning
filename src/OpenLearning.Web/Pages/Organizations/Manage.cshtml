@page
@model OpenLearning.Web.Pages.Organizations.ManageModel
@{ ViewData["Title"] = "Organization management"; }
<h1>@Model.Active.Name</h1><p class="text-muted">Active tenant scope · @Model.Active.Role</p>
<div class="row g-4"><section class="col-lg-6"><h2 class="h4">Departments</h2><form method="post" asp-page-handler="Department"><input name="name" required maxlength="200" class="form-control mb-2" placeholder="Department"/><select name="parentId" class="form-select mb-2"><option value="">Root</option>@foreach(var d in Model.Departments){<option value="@d.Id">@d.Name</option>}</select><button class="btn btn-primary">Add</button></form><ul>@foreach(var d in Model.Departments){<li>#@d.Id @d.Name (parent @(d.ParentId?.ToString() ?? "root"))</li>}</ul></section>
<section class="col-lg-6"><h2 class="h4">Members</h2><form method="post" asp-page-handler="Member"><select name="userId" class="form-select mb-2">@foreach(var u in Model.Users){<option value="@u.Id">@u.Email</option>}</select><select name="role" asp-items="Html.GetEnumSelectList<OrganizationRole>()" class="form-select mb-2"></select><button class="btn btn-primary">Add or update</button></form><ul>@foreach(var m in Model.Memberships){<li>@m.User?.Email — @m.Role / @m.Status</li>}</ul></section>
<section class="col-lg-6"><h2 class="h4">Invite</h2><form method="post" asp-page-handler="Invite"><input name="email" type="email" required class="form-control mb-2"/><select name="role" asp-items="Html.GetEnumSelectList<OrganizationRole>()" class="form-select mb-2"></select><button class="btn btn-primary">Create invitation</button></form></section>
<section class="col-lg-6"><h2 class="h4">Tenant courses</h2><form method="post" asp-page-handler="Course"><select name="courseId" class="form-select mb-2">@foreach(var c in Model.Courses){<option value="@c.Id">@c.Title</option>}</select><button class="btn btn-primary">Assign</button></form><ul>@foreach(var c in Model.AssignedCourses){<li>@c.Course?.Title</li>}</ul></section></div>
