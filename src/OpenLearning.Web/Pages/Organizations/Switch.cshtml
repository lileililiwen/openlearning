@page
@model OpenLearning.Web.Pages.Organizations.SwitchModel
@{ ViewData["Title"] = "Select organization"; }
<h1>Select organization</h1><div class="list-group">@foreach(var item in Model.Memberships){<form method="post" class="list-group-item d-flex justify-content-between"><input type="hidden" name="organizationId" value="@item.OrganizationId"/><span>@item.Organization!.Name — @item.Role</span><button class="btn btn-primary btn-sm">Use</button></form>}</div><form method="post" asp-page-handler="Clear" class="mt-3"><button class="btn btn-outline-secondary">Use global context</button></form>
