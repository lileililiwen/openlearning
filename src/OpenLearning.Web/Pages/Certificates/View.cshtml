@page
@model OpenLearning.Web.Pages.Certificates.ViewModel
@{
    ViewData["Title"] = "Certificate of Completion";
}

<div class="d-print-none my-3">
    <a class="btn btn-outline-secondary" asp-page="/Dashboard/Index">&larr; Back to dashboard</a>
    <button type="button" class="btn btn-primary ms-2" onclick="window.print()">Print / Save as PDF</button>
</div>

<div class="certificate-sheet border border-4 p-5 my-4 mx-auto" style="max-width: 800px">
    <div class="text-center">
        <div class="text-muted small text-uppercase letter-spacing-2 mb-4">Certificate of Completion</div>
        <h1 class="display-6 fw-bold mb-3">OpenLearning</h1>
        <p class="text-muted mb-4">This certifies that</p>
        <h2 class="fw-bold text-primary mb-4">@Model.RecipientName</h2>
        <p class="text-muted mb-1">has successfully completed the course</p>
        <h3 class="fw-semibold mb-4">@Model.CourseTitle</h3>
        @if (!string.IsNullOrEmpty(Model.InstructorName))
        {
            <p class="text-muted mb-1">Instructed by <strong>@Model.InstructorName</strong></p>
        }
        <p class="text-muted mb-0">
            Completed on @Model.Certificate!.IssuedAt.ToString("MMMM d, yyyy")
        </p>
        <hr class="my-4 w-50 mx-auto" />
        <div class="text-muted small">
            Certificate code: <span class="font-monospace">@Model.Certificate.Code</span>
        </div>
    </div>
</div>

<style>
    .letter-spacing-2 { letter-spacing: 0.2em; }
    .certificate-sheet { background: #fff; }
    @@media print {
        .certificate-sheet { border-width: 4px !important; margin: 0 auto !important; max-width: 100% !important; }
        body { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    }
</style>
