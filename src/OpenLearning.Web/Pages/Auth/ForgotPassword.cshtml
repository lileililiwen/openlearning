@page
@model OpenLearning.Web.Pages.Auth.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot Password";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h4 mb-3">Forgot your password?</h1>

                @if (Model.LinkShown)
                {
                    <div class="alert alert-warning">
                        <strong>Development build:</strong> no email provider is configured, so here is your
                        password-reset link to use right now.
                        <div class="mt-2">
                            <a href="@Model.DevResetLink">@Model.DevResetLink</a>
                        </div>
                    </div>
                }
                else
                {
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
                        <div class="mb-3">
                            <label asp-for="Input.Email" class="form-label"></label>
                            <input asp-for="Input.Email" class="form-control" autofocus />
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Send reset link</button>
                    </form>
                }

                <p class="mt-3 mb-0 text-center small">
                    Remembered it?
                    <a asp-page="/Auth/Login">Sign in</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
