@page
@model OpenLearning.Web.Pages.Auth.VerifyCodeModel
@{
    ViewData["Title"] = "Verify Code";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h4 mb-3">Verify your code</h1>
                <p class="text-muted small mb-4">
                    We sent a one-time code to <strong>@Model.PhoneNumber</strong>.
                </p>

                @if (TempData["Message"] is string message)
                {
                    <div class="alert alert-@(TempData["MessageType"] ?? "success") alert-dismissible fade show" role="alert">
                        @message
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @if (TempData["DevCode"] is string devCode)
                {
                    <div class="alert alert-warning">
                        <strong>Development mode</strong> — no SMS gateway is configured. Your code is:
                        <span class="font-monospace fw-bold fs-5">@devCode</span>
                    </div>
                }

                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
                    <input type="hidden" asp-for="PhoneNumber" />
                    <div class="mb-3">
                        <label asp-for="Input.Code" class="form-label">Verification code</label>
                        <input asp-for="Input.Code" class="form-control" inputmode="numeric" autocomplete="one-time-code" autofocus />
                        <span asp-validation-for="Input.Code" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Verify and sign in</button>
                </form>

                <hr />
                <p class="small text-center mb-0">
                    <a asp-page="/Auth/PhoneLogin">Request a new code</a>
                </p>
            </div>
        </div>
    </div>
</div>
