@page
@model OpenLearning.Web.Pages.Auth.LoginModel
@{
    ViewData["Title"] = "Sign in";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h4 mb-3">Sign in</h1>

                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label"></label>
                        <input asp-for="Input.Email" class="form-control" autofocus />
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.Password" class="form-label"></label>
                        <input asp-for="Input.Password" class="form-control" />
                        <span asp-validation-for="Input.Password" class="text-danger small"></span>
                    </div>
                    <div class="form-check mb-3">
                        <input asp-for="Input.RememberMe" class="form-check-input" />
                        <label asp-for="Input.RememberMe" class="form-check-label"></label>
                    </div>

                    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                    <button type="submit" class="btn btn-primary w-100">Sign in</button>
                </form>

                <p class="mt-3 mb-3 text-center small">
                    <a asp-page="/Auth/ForgotPassword">Forgot your password?</a>
                </p>

                <div class="alert alert-light border mt-0 mb-0 small">
                    <strong>Demo accounts</strong>
                    <ul class="mb-0 mt-1 ps-3">
                        <li>student@openlearning.dev / Student123!</li>
                        <li>instructor@openlearning.dev / Instructor123!</li>
                        <li>admin@openlearning.dev / Admin123!</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
