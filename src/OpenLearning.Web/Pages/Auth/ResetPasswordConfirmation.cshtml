@page
@model OpenLearning.Web.Pages.Auth.ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Password Reset";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body p-4 text-center">
                <h1 class="h4 mb-3">Password reset</h1>
                <p class="text-muted mb-4">Your password has been updated. You can now sign in.</p>
                <a class="btn btn-primary" asp-page="/Auth/Login">Sign in</a>
            </div>
        </div>
    </div>
</div>
