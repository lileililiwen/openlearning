@using Microsoft.AspNetCore.Identity
@using System.Security.Claims
@using Microsoft.AspNetCore.Mvc.RazorPages
@using OpenLearning.Navigation.Services
@using OpenLearning.Navigation.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject MenuService MenuService
@inject NavCounterService NavCounters
@inject NavPreferencesService NavPrefs
@inject BreadcrumbService Breadcrumbs
@inject OpenLearning.Notifications.Services.NotificationService NotificationService
@inject OpenLearning.SystemConfig.Services.SystemConfigService SystemConfig
@inject OpenLearning.Ecommerce.Services.CartService CartService
@inject IOrganizationContext OrganizationContext
@{
    var siteName = await SystemConfig.GetStringAsync("Site.Name", "OpenLearning");
    var roles = new List<string>();
    var currentUser = (ApplicationUser?)null;
    var cartCount = 0;
    var unreadCount = 0;
    var isSignedIn = SignInManager.IsSignedIn(User);
    var activeOrganization = isSignedIn ? await OrganizationContext.GetActiveAsync() : null;
    if (isSignedIn)
    {
        currentUser = await UserManager.GetUserAsync(User);
        var uid = User.FindFirstValue(ClaimTypes.NameIdentifier)!;
        if (User.IsInRole(OpenLearning.Auth.Roles.Student)) { roles.Add(OpenLearning.Auth.Roles.Student); }
        if (User.IsInRole(OpenLearning.Auth.Roles.Instructor)) { roles.Add(OpenLearning.Auth.Roles.Instructor); }
        if (User.IsInRole(OpenLearning.Auth.Roles.Admin)) { roles.Add(OpenLearning.Auth.Roles.Admin); }
        cartCount = await CartService.GetCountAsync(uid);
        unreadCount = await NotificationService.GetUnreadCountAsync(uid);
    }

    var menu = await MenuService.GetTreeAsync(roles);
    var navCounts = await NavCounters.GetCountsAsync();
    var collapsedGroups = NavPrefs.GetCollapsedGroups();

    var pageDescriptor = ViewContext.ActionDescriptor as CompiledPageActionDescriptor;
    var crumbs = pageDescriptor?.ModelTypeInfo?.AsType() is { } modelType
        ? Breadcrumbs.GetCrumbs(modelType)
        : (IReadOnlyList<BreadcrumbCrumb>)Array.Empty<BreadcrumbCrumb>();
}
<!DOCTYPE html>
<html lang="zh">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — @siteName</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site-chrome.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        @if (isSignedIn)
        {
            <aside class="app-sidebar" id="appSidebar">
                <div class="sidebar-brand">
                    <a class="sidebar-brand-link" asp-page="/Index" title="@siteName">
                        <i class="bi bi-mortarboard-fill"></i>
                        <span class="sidebar-brand-text">@siteName</span>
                    </a>
                    <button type="button" class="btn btn-link sidebar-close d-lg-none" data-sidebar-close aria-label="Close">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
                <nav class="sidebar-nav">
                    @foreach (var group in menu.Groups)
                    {
                        if (group.Items.Count == 0)
                        {
                            continue;
                        }

                        var isCollapsed = collapsedGroups.Contains(group.Key);
                        <div class="nav-group @(isCollapsed ? "collapsed" : "")">
                            <button type="button" class="nav-group-toggle" data-group-key="@group.Key"
                                    aria-expanded="@(isCollapsed ? "false" : "true")">
                                <i class="bi @(group.IconKey ?? "bi-folder")"></i>
                                <span class="nav-label">@group.Label</span>
                                <i class="bi bi-chevron-down nav-caret"></i>
                            </button>
                            <ul class="nav-group-items">
                                @foreach (var item in group.Items)
                                {
                                    var active = ViewContext.RouteData.Values["page"]?.ToString() == item.Route;
                                    var count = item.CounterKey is not null && navCounts.TryGetValue(item.CounterKey, out var c) ? c : 0;
                                    <li>
                                        <a class="nav-item-link @(active ? "active" : "")" asp-page="@item.Route">
                                            @if (!string.IsNullOrEmpty(item.IconKey))
                                            {
                                                <i class="bi @item.IconKey"></i>
                                            }
                                            <span class="nav-label">@item.Label</span>
                                            @if (count > 0)
                                            {
                                                <span class="badge rounded-pill bg-danger nav-badge">@count</span>
                                            }
                                        </a>
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                </nav>
            </aside>
            <div class="sidebar-backdrop" data-sidebar-close></div>
        }

        <div class="app-main">
            <header class="app-topbar">
                <div class="d-flex align-items-center gap-3">
                    <button type="button" class="btn btn-link topbar-toggle d-lg-none" data-sidebar-open aria-label="Open menu">
                        <i class="bi bi-list fs-4"></i>
                    </button>
                    <a class="topbar-brand d-lg-none" asp-page="/Index">@siteName</a>
                    <span class="topbar-title d-none d-lg-inline">@ViewData["Title"]</span>
                </div>
                <div class="d-flex align-items-center gap-2 ms-auto">
                    @if (isSignedIn)
                    {
                        <a class="btn btn-sm btn-outline-primary" asp-page="/Organizations/Switch" style="border-color:@activeOrganization?.PrimaryColor">
                            <i class="bi bi-building"></i> @(activeOrganization?.Name ?? "Global")
                        </a>
                    }
                    <a class="topbar-icon-link position-relative" asp-page="/Cart" title="购物车">
                        <i class="bi bi-cart3"></i>
                        @if (cartCount > 0)
                        {
                            <span class="badge rounded-pill bg-danger position-absolute top-0 start-100 translate-middle">@cartCount</span>
                        }
                    </a>
                    <a class="topbar-icon-link position-relative" asp-page="/Account/Notifications" title="通知">
                        <i class="bi bi-bell"></i>
                        @if (unreadCount > 0)
                        {
                            <span class="badge rounded-pill bg-danger position-absolute top-0 start-100 translate-middle">@unreadCount</span>
                        }
                    </a>
                    <div class="dropdown">
                        <button class="btn btn-light btn-sm dropdown-toggle d-flex align-items-center gap-2" type="button"
                                data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person-circle fs-5"></i>
                            <span class="d-none d-md-inline">@(currentUser?.DisplayName ?? User.Identity?.Name)</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" asp-page="/Profile/Index"><i class="bi bi-person me-2"></i>个人设置</a></li>
                            <li><a class="dropdown-item" asp-page="/Memberships/Index"><i class="bi bi-award me-2"></i>会员方案</a></li>
                            @if (!User.IsInRole(OpenLearning.Auth.Roles.Instructor) && !User.IsInRole(OpenLearning.Auth.Roles.Admin))
                            {
                                <li><a class="dropdown-item" asp-page="/ApplyInstructor"><i class="bi bi-person-badge me-2"></i>成为教师</a></li>
                            }
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form method="post" asp-page="/Auth/Logout" class="d-inline">
                                    <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i>退出登录</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            @if (currentUser?.IsSuspended == true)
            {
                <div class="container mt-3">
                    <div class="alert alert-danger mb-0" role="alert">
                        您的账户已被<strong>停用</strong>。在管理员重新启用之前，您无法学习、教学或聊天。
                    </div>
                </div>
            }

            @if (crumbs.Count > 0)
            {
                <nav aria-label="breadcrumb" class="app-breadcrumb">
                    <ol class="breadcrumb mb-0">
                        @foreach (var crumb in crumbs)
                        {
                            if (crumb.Route is not null)
                            {
                                <li class="breadcrumb-item"><a asp-page="@crumb.Route">@crumb.Label</a></li>
                            }
                            else
                            {
                                <li class="breadcrumb-item active" aria-current="page">@crumb.Label</li>
                            }
                        }
                    </ol>
                </nav>
            }

            <main class="app-content pb-5">
                @RenderBody()
            </main>

            <footer class="app-footer">
                <div class="container">
                    <small>@(siteName) — MIT licensed. For local development and demonstration.</small>
                </div>
            </footer>
        </div>
    </div>

    <!-- Scheduled pop-up: shown once per session via a localStorage key. -->
    <div class="modal fade" id="opsPopupModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="opsPopupTitle"></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" id="opsPopupBody"></div>
                <div class="modal-footer">
                    <a id="opsPopupLink" href="#" class="btn btn-primary">了解更多</a>
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">关闭</button>
                </div>
            </div>
        </div>
    </div>
    <script>
        (function () {
            var KEY = 'openlearning-popup-seen';
            if (sessionStorage.getItem(KEY)) {
                return;
            }
            fetch('/ops/popup', { credentials: 'same-origin' })
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    if (!data.shown) {
                        return;
                    }
                    document.getElementById('opsPopupTitle').textContent = data.title;
                    document.getElementById('opsPopupBody').textContent = data.body;
                    var link = document.getElementById('opsPopupLink');
                    link.href = data.linkUrl || '#';
                    sessionStorage.setItem(KEY, '1');
                    new bootstrap.Modal(document.getElementById('opsPopupModal')).show();
                })
                .catch(function () { /* best-effort */ });
        })();
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site-chrome.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
