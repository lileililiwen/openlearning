@using Microsoft.AspNetCore.Identity
@using System.Security.Claims
@using OpenLearning.Notifications.Services
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject NotificationService NotificationService
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — OpenLearning</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @{
        ApplicationUser? currentUser = null;
        if (SignInManager.IsSignedIn(User))
        {
            currentUser = await UserManager.GetUserAsync(User);
        }
    }
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary mb-4">
        <div class="container">
            <a class="navbar-brand fw-bold" asp-page="/Index">OpenLearning</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                    aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Index">Catalog</a>
                    </li>
                    @if (User.IsInRole(Roles.Student))
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Dashboard/Index">Dashboard</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/MyCourses">My Courses</a>
                        </li>
                    }
                    @if (User.IsInRole(Roles.Instructor))
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Dashboard/Teacher">Dashboard</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Courses/Manage">My Courses</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Courses/Create">New Course</a>
                        </li>
                    }
                    @if (User.IsInRole(Roles.Admin))
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Admin/Index">Dashboard</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Admin/Users">Users</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Admin/Courses">Courses</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Admin/InstructorApplications">Applications</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Reports</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-page="/Admin/Reports/Revenue">Revenue</a></li>
                                <li><a class="dropdown-item" asp-page="/Admin/Reports/Enrollments">Enrollments</a></li>
                                <li><a class="dropdown-item" asp-page="/Admin/Reports/Users">Users</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Logs</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-page="/Admin/Logs/Operations">Operations</a></li>
                                <li><a class="dropdown-item" asp-page="/Admin/Logs/Errors">Errors</a></li>
                            </ul>
                        </li>
                    }
                    @if (SignInManager.IsSignedIn(User) && !User.IsInRole(Roles.Instructor) && !User.IsInRole(Roles.Admin))
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/ApplyInstructor">Become an Instructor</a>
                        </li>
                    }
                </ul>
                <ul class="navbar-nav">
                    @if (SignInManager.IsSignedIn(User))
                    {
                        var unreadCount = await NotificationService.GetUnreadCountAsync(User.FindFirstValue(ClaimTypes.NameIdentifier)!);
                        <li class="nav-item">
                            <a class="nav-link position-relative" asp-page="/Notifications" title="Notifications">
                                &#128276;
                                @if (unreadCount > 0)
                                {
                                    <span class="badge rounded-pill bg-danger position-absolute top-0 start-100 translate-middle"
                                          style="font-size: 0.65rem">@unreadCount</span>
                                }
                            </a>
                        </li>
                        <li class="nav-item">
                            <span class="navbar-text text-white me-3">
                                <a class="text-white text-decoration-none" asp-page="/Profile/Index">@(currentUser?.DisplayName ?? User.Identity?.Name)</a>
                            </span>
                        </li>
                        <li class="nav-item">
                            <form method="post" asp-page="/Auth/Logout" class="d-inline">
                                <button type="submit" class="btn btn-outline-light btn-sm">Sign out</button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Auth/Login">Sign in</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Auth/Register">Register</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    @if (currentUser?.IsSuspended == true)
    {
        <div class="container mb-4">
            <div class="alert alert-danger mb-0" role="alert">
                Your account is <strong>suspended</strong>. You cannot learn, teach, or chat until an admin reactivates it.
            </div>
        </div>
    }

    <main class="container pb-5">
        @RenderBody()
    </main>

    <footer class="text-center text-muted py-4 border-top">
        <div class="container">
            <small>OpenLearning — MIT licensed. For local development and demonstration.</small>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
