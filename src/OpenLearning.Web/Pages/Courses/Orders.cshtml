@page
@model OpenLearning.Web.Pages.Courses.OrdersModel
@{
    ViewData["Title"] = "Course Orders";
    var course = Model.Course!;
    var paidCount = Model.Orders.Count(o => o.Status == OrderStatus.Paid);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-0">@course.Title — Orders</h1>
        <p class="text-muted mb-0">
            @paidCount paid purchase(s) · Revenue @Model.TotalRevenue.ToString("C")
        </p>
    </div>
    <a class="btn btn-outline-primary" asp-page="/Courses/Edit" asp-route-id="@course.Id">Edit course</a>
</div>

@if (Model.Orders.Count == 0)
{
    <div class="alert alert-info">No orders yet. Orders appear here when students purchase this course.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle bg-white shadow-sm rounded">
            <thead>
                <tr>
                    <th>Student</th>
                    <th>Amount</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th>Paid at</th>
                    <th>Reference</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model.Orders)
                {
                    <tr>
                        <td>@(order.Student?.DisplayName ?? order.StudentId)</td>
                        <td>@order.Amount.ToString("C")</td>
                        <td>
                            @if (order.Status == OrderStatus.Paid)
                            {
                                <span class="badge bg-success">Paid</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Pending</span>
                            }
                        </td>
                        <td>@order.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@(order.PaidAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                        <td>@order.PaymentReference</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
