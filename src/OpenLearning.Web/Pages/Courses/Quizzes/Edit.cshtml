@page
@model OpenLearning.Web.Pages.Courses.Quizzes.EditModel
@{
    ViewData["Title"] = "Edit Quiz";
    var quiz = Model.Quiz!;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Edit quiz</h1>
    <a class="btn btn-outline-primary" asp-page="/Courses/Edit" asp-route-id="@quiz.CourseId">Back to course</a>
</div>

<form method="post" class="card shadow-sm mb-4">
    <div class="card-body p-4">
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label asp-for="Input.Title" class="form-label"></label>
            <input asp-for="Input.Title" class="form-control" autofocus />
            <span asp-validation-for="Input.Title" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Input.Description" class="form-label"></label>
            <textarea asp-for="Input.Description" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Input.Description" class="text-danger small"></span>
        </div>

        <button type="submit" class="btn btn-primary">Save quiz</button>
    </div>
</form>

<div class="card shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <strong>Questions (@quiz.Questions.Count)</strong>
        <a class="btn btn-sm btn-primary" asp-page="/Courses/Quizzes/Questions/Create" asp-route-quizId="@quiz.Id">Add question</a>
    </div>
    <ul class="list-group list-group-flush">
        @if (quiz.Questions.Count == 0)
        {
            <li class="list-group-item text-muted">
                No questions yet. Add a question to let students take this quiz.
            </li>
        }
        else
        {
            foreach (var question in quiz.Questions)
            {
                <li class="list-group-item">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="fw-semibold">Q@(question.OrderIndex). @question.Text</span>
                            <span class="badge bg-secondary ms-2">@question.Points pt</span>
                        </div>
                        <span class="d-inline-flex gap-2">
                            <a class="btn btn-sm btn-outline-secondary" asp-page="/Courses/Quizzes/Questions/Edit" asp-route-id="@question.Id">Edit</a>
                            <a class="btn btn-sm btn-outline-danger" asp-page="/Courses/Quizzes/Questions/Delete" asp-route-id="@question.Id">Delete</a>
                        </span>
                    </div>
                    <ul class="list-unstyled ms-3 mt-2 mb-0 small">
                        @foreach (var option in question.AnswerOptions.OrderBy(o => o.OrderIndex))
                        {
                            <li>
                                @if (option.IsCorrect)
                                {
                                    <span class="text-success">&#10003; @option.Text</span>
                                }
                                else
                                {
                                    <span>@option.Text</span>
                                }
                            </li>
                        }
                    </ul>
                </li>
            }
        }
    </ul>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
