@page
@model OpenLearning.Web.Pages.Courses.Quizzes.ImportFromBankModel
@{
    ViewData["Title"] = "从题库导入";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">从题库导入题目</h1>
    <a class="btn btn-outline-secondary btn-sm" asp-page="/Courses/Quizzes/Edit" asp-route-id="@Model.QuizId">返回测验编辑</a>
</div>

<p class="text-muted small">导入的题目是<strong>快照</strong>：后续修改题库中的原题不会影响已导入的副本。</p>

<form method="get" class="row g-2 mb-3">
    <input type="hidden" name="quizId" value="@Model.QuizId" />
    <div class="col-md-4">
        <input name="Topic" value="@Model.Topic" class="form-control form-control-sm" placeholder="主题" />
    </div>
    <div class="col-md-5">
        <input name="Text" value="@Model.Text" class="form-control form-control-sm" placeholder="题干关键词" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-sm btn-outline-primary">搜索</button>
    </div>
</form>

@if (Model.Items.Count == 0)
{
    <div class="alert alert-info">题库中暂无匹配的题目。</div>
}
else
{
    <form method="post">
        <input type="hidden" name="quizId" value="@Model.QuizId" />
        <div class="card shadow-sm mb-3">
            <ul class="list-group list-group-flush">
                @foreach (var q in Model.Items)
                {
                    <li class="list-group-item">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="selected" value="@q.Id" id="q@(q.Id)" />
                            <label class="form-check-label" for="q@(q.Id)">
                                <strong>@q.Text</strong>
                                <span class="badge bg-secondary ms-1">@q.QuestionType</span>
                                <span class="badge bg-light text-dark border ms-1">@q.Points pt</span>
                                @if (!string.IsNullOrEmpty(q.BankTopic))
                                {
                                    <span class="badge bg-info text-dark ms-1">@q.BankTopic</span>
                                }
                            </label>
                        </div>
                    </li>
                }
            </ul>
        </div>
        <button type="submit" class="btn btn-primary">导入所选题目</button>
    </form>
}
