@page
@model OpenLearning.Web.Pages.Courses.Live.IndexModel
@{
    ViewData["Title"] = "Live Sessions";
    var course = Model.Course!;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="/Index">Catalog</a></li>
        <li class="breadcrumb-item">
            <a asp-page="/Courses/Details" asp-route-id="@course.Id">@course.Title</a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">Live Sessions</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-end mb-3">
    <div>
        <h1 class="h3 mb-1">Live Sessions</h1>
        <p class="text-muted mb-0">Scheduled, ongoing, and recorded live classes.</p>
    </div>
    <a class="btn btn-outline-primary" asp-page="/Courses/Details" asp-route-id="@course.Id">Back to course</a>
</div>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-@(TempData["MessageType"] ?? "success") alert-dismissible fade show" role="alert">
        @message
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (Model.IsOwner)
{
    <form method="post" asp-page-handler="Create" class="card shadow-sm mb-4">
        <div class="card-header bg-white"><strong>Schedule a new live session</strong></div>
        <div class="card-body">
            <input type="hidden" asp-for="CourseId" />
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Input.Title" class="form-label">Title</label>
                    <input asp-for="Input.Title" class="form-control" required />
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.Description" class="form-label">Description (optional)</label>
                    <input asp-for="Input.Description" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.StartsAt" class="form-label">Starts at</label>
                    <input asp-for="Input.StartsAt" type="datetime-local" class="form-control" required />
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.EndsAt" class="form-label">Ends at</label>
                    <input asp-for="Input.EndsAt" type="datetime-local" class="form-control" required />
                </div>
            </div>
            <button type="submit" class="btn btn-primary mt-3">Schedule session</button>
        </div>
    </form>
}

@if (Model.Sessions.Count == 0)
{
    <div class="alert alert-info">No live sessions have been scheduled yet.</div>
}
else
{
    <div class="row g-3">
        @foreach (var session in Model.Sessions)
        {
            var canManage = Model.ManageableSessionIds.Contains(session.Id);
            <div class="col-12">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h2 class="h5 mb-1">@session.Title</h2>
                                <p class="text-muted small mb-1">
                                    @session.StartsAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                                    – @session.EndsAt.ToLocalTime().ToString("HH:mm")
                                    <span class="ms-2">
                                        @if (session.Status == LiveSessionStatus.Scheduled)
                                        {
                                            <span class="badge bg-secondary">Scheduled</span>
                                        }
                                        else if (session.Status == LiveSessionStatus.Live)
                                        {
                                            <span class="badge bg-danger">Live</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-dark">Ended</span>
                                        }
                                    </span>
                                </p>
                                @if (!string.IsNullOrWhiteSpace(session.Description))
                                {
                                    <p class="mb-1">@session.Description</p>
                                }
                                @if (session.CoHosts.Count > 0)
                                {
                                    <p class="text-muted small mb-0">
                                        Co-hosts:
                                        @string.Join(", ", session.CoHosts.Select(h => h.User?.DisplayName ?? h.UserId))
                                    </p>
                                }
                            </div>
                            <div class="d-flex flex-wrap gap-2 align-items-center">
                                <a class="btn btn-sm btn-primary" asp-page="Room" asp-route-id="@session.Id">
                                    @(session.Status == LiveSessionStatus.Ended ? "Watch replay" : "Join room")
                                </a>
                                @if (canManage)
                                {
                                    if (session.Status == LiveSessionStatus.Scheduled)
                                    {
                                        <form method="post" asp-page-handler="Start" asp-route-sessionId="@session.Id">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Start</button>
                                        </form>
                                    }
                                    else if (session.Status == LiveSessionStatus.Live)
                                    {
                                        <form method="post" asp-page-handler="End" asp-route-sessionId="@session.Id">
                                            <button type="submit" class="btn btn-sm btn-outline-dark">End</button>
                                        </form>
                                    }
                                }
                                @if (Model.IsOwner)
                                {
                                    <a class="btn btn-sm btn-outline-primary" asp-page="Edit" asp-route-id="@session.Id">Edit</a>
                                    <form method="post" asp-page-handler="Delete" asp-route-sessionId="@session.Id"
                                          onsubmit="return confirm('Delete this live session?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                    </form>
                                }
                            </div>
                        </div>
                        @if (Model.IsOwner)
                        {
                            <hr />
                            <form method="post" asp-page-handler="AddCoHost" asp-route-sessionId="@session.Id" class="d-flex gap-2">
                                <input name="email" class="form-control form-control-sm" maxlength="200"
                                       placeholder="Invite a co-host by email…" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary">Invite</button>
                            </form>
                            @if (session.CoHosts.Count > 0)
                            {
                                <div class="mt-2">
                                    @foreach (var host in session.CoHosts)
                                    {
                                        <form method="post" asp-page-handler="RemoveCoHost" asp-route-sessionId="@session.Id" asp-route-coHostId="@host.UserId" class="d-inline me-2">
                                            <span class="badge bg-light text-dark border">
                                                @(host.User?.DisplayName ?? host.UserId)
                                                <button type="submit" class="btn btn-link btn-sm text-danger p-0 ms-1">✕</button>
                                            </span>
                                        </form>
                                    }
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
