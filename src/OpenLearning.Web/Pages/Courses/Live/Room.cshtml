@page
@model OpenLearning.Web.Pages.Courses.Live.RoomModel
@{
    ViewData["Title"] = "Live Room";
    var course = Model.Course!;
    var session = Model.Session!;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="/Index">Catalog</a></li>
        <li class="breadcrumb-item"><a asp-page="/Courses/Details" asp-route-id="@course.Id">@course.Title</a></li>
        <li class="breadcrumb-item"><a asp-page="/Courses/Live/Index" asp-route-id="@course.Id">Live Sessions</a></li>
        <li class="breadcrumb-item active" aria-current="page">@session.Title</li>
    </ol>
</nav>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-@(TempData["MessageType"] ?? "success") alert-dismissible fade show" role="alert">
        @message
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-end mb-3">
    <div>
        <h1 class="h3 mb-1">
            @session.Title
            @if (session.Status == LiveSessionStatus.Scheduled)
            {
                <span class="badge bg-secondary ms-2">Scheduled</span>
            }
            else if (session.Status == LiveSessionStatus.Live)
            {
                <span class="badge bg-danger ms-2">● Live</span>
            }
            else
            {
                <span class="badge bg-dark ms-2">Ended</span>
            }
        </h1>
        <p class="text-muted mb-0">
            @session.StartsAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
            – @session.EndsAt.ToLocalTime().ToString("HH:mm")
            · Instructor: @(session.Instructor?.DisplayName ?? session.InstructorId)
            @if (session.CoHosts.Count > 0)
            {
                <text> · Co-hosts: @string.Join(", ", session.CoHosts.Select(h => h.User?.DisplayName ?? h.UserId))</text>
            }
        </p>
    </div>
    <a class="btn btn-outline-primary" asp-page="/Courses/Live/Index" asp-route-id="@course.Id">All sessions</a>
</div>

@if (Model.CanManage)
{
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="d-flex flex-wrap gap-2 align-items-center">
                <strong>Host controls</strong>
                @if (session.Status == LiveSessionStatus.Scheduled)
                {
                    <form method="post" asp-page-handler="Start" asp-route-id="@session.Id">
                        <button type="submit" class="btn btn-sm btn-danger">Start session</button>
                    </form>
                }
                else if (session.Status == LiveSessionStatus.Live)
                {
                    <form method="post" asp-page-handler="End" asp-route-id="@session.Id">
                        <button type="submit" class="btn btn-sm btn-dark">End session</button>
                    </form>
                }
                else if (session.Status == LiveSessionStatus.Ended && string.IsNullOrWhiteSpace(Model.ReplayUrl))
                {
                    <form method="post" asp-page-handler="AttachRecording" asp-route-id="@session.Id" class="d-flex gap-2">
                        <input name="fileId" type="number" class="form-control form-control-sm" style="max-width: 160px"
                               placeholder="Recording file id" required />
                        <button type="submit" class="btn btn-sm btn-outline-primary">Attach replay</button>
                    </form>
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(session.StreamKey))
            {
                <div class="mt-2 small">
                    <strong>Stream key (secret):</strong>
                    <code>@session.StreamKey</code>
                    <span class="text-muted">Use this as the push key with your streaming provider.</span>
                </div>
            }
        </div>
    </div>
}

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body p-0">
                @if (session.Status == LiveSessionStatus.Live && !string.IsNullOrWhiteSpace(session.StreamUrl))
                {
                    <video controls autoplay style="width: 100%; aspect-ratio: 16 / 9; background: #000" src="@session.StreamUrl"></video>
                }
                else if (session.Status == LiveSessionStatus.Ended && !string.IsNullOrWhiteSpace(Model.ReplayUrl))
                {
                    <video controls style="width: 100%; aspect-ratio: 16 / 9; background: #000" src="@Model.ReplayUrl"></video>
                    <div class="p-3 text-muted small">This is the session recording.</div>
                }
                else
                {
                    <div class="d-flex align-items-center justify-content-center text-center text-muted p-5" style="aspect-ratio: 16 / 9; background: #000">
                        <div>
                            @if (session.Status == LiveSessionStatus.Live)
                            {
                                <p class="h5 text-light">Stream starting soon…</p>
                            }
                            else if (session.Status == LiveSessionStatus.Scheduled)
                            {
                                <p class="h5 text-light">This session has not started yet.</p>
                            }
                            else
                            {
                                <p class="h5 text-light">No recording has been attached.</p>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        @if (Model.IsEnrolled && session.Status == LiveSessionStatus.Live && Model.InCheckInWindow && !Model.HasCheckedIn)
        {
            <form method="post" asp-page-handler="CheckIn" asp-route-id="@session.Id" class="card shadow-sm mt-3">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <span>Mark your attendance for this session.</span>
                    <button type="submit" class="btn btn-success">Check in</button>
                </div>
            </form>
        }
        else if (Model.HasCheckedIn)
        {
            <div class="alert alert-success mt-3 mb-0">
                <strong>Checked in.</strong> Your attendance has been recorded.
            </div>
        }
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <strong>Live chat</strong>
                <span class="text-muted small ms-2" id="connection-state">connecting…</span>
            </div>
            <div class="card-body">
                <div id="messages" style="max-height: 360px; overflow-y: auto">
                    @if (Model.Messages.Count == 0)
                    {
                        <p class="text-muted small mb-3">No messages yet. Say hello!</p>
                    }
                    else
                    {
                        foreach (var chat in Model.Messages)
                        {
                            <div class="mb-2" data-sent-at="@chat.SentAt.ToString("o")">
                                <strong>@(chat.User?.DisplayName ?? chat.UserId)</strong>
                                <span class="text-muted small ms-2">@chat.SentAt.ToLocalTime().ToString("HH:mm")</span>
                                <div>@chat.Body</div>
                            </div>
                        }
                    }
                </div>
            </div>
            <div class="card-footer bg-white">
                <form id="chat-form" class="d-flex gap-2">
                    <input id="message-input" type="text" class="form-control" maxlength="2000"
                           placeholder="Type a message…" autocomplete="off" />
                    <button id="send-button" type="submit" class="btn btn-primary">Send</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@@8.0.7/dist/browser/signalr.min.js"></script>
    <script>
        (function () {
            "use strict";
            var sessionId = @session.Id;
            var messagesEl = document.getElementById("messages");
            var stateEl = document.getElementById("connection-state");
            var form = document.getElementById("chat-form");
            var input = document.getElementById("message-input");

            function appendMessage(userName, body, sentAt) {
                var empty = messagesEl.querySelector(".text-muted");
                if (empty) { empty.remove(); }
                var time = sentAt ? new Date(sentAt).toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" }) : "";
                var div = document.createElement("div");
                div.className = "mb-2";
                div.innerHTML = "<strong></strong><span class='text-muted small ms-2'></span><div></div>";
                div.querySelector("strong").textContent = userName;
                div.querySelector("span").textContent = time;
                div.querySelector("div").textContent = body;
                messagesEl.appendChild(div);
                messagesEl.scrollTop = messagesEl.scrollHeight;
            }

            var connection = new signalR.HubConnectionBuilder()
                .withUrl("/hubs/live-chat")
                .build();

            connection.on("ReceiveLiveMessage", function (userName, body, sentAt) {
                appendMessage(userName, body, sentAt);
            });

            connection.start().then(function () {
                stateEl.textContent = "connected";
                return connection.invoke("JoinLive", sessionId);
            }).catch(function (err) {
                stateEl.textContent = "connection failed";
                console.error(err);
            });

            form.addEventListener("submit", function (e) {
                e.preventDefault();
                var body = input.value.trim();
                if (!body) { return; }
                connection.invoke("SendLiveMessage", sessionId, body).catch(function (err) {
                    console.error(err);
                });
                input.value = "";
            });
        })();
    </script>
}
