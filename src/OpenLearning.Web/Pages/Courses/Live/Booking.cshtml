@page "{id:int}"
@model OpenLearning.Web.Pages.Courses.Live.BookingModel
@{
    ViewData["Title"] = "Booking Configuration";
    var session = Model.Session!;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="/Index">Catalog</a></li>
        <li class="breadcrumb-item"><a asp-page="/Courses/Live/Index" asp-route-id="@session.CourseId">Live Sessions</a></li>
        <li class="breadcrumb-item active" aria-current="page">Booking Config</li>
    </ol>
</nav>

<h1 class="h3 mb-4">Booking Configuration — @session.Title</h1>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-@TempData["MessageType"] alert-dismissible fade show" role="alert">
        @message
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<form method="post" class="card shadow-sm">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
        <div class="row g-3">
            <div class="col-md-12">
                <div class="form-check">
                    <input asp-for="Input.IsBookingEnabled" class="form-check-input" />
                    <label asp-for="Input.IsBookingEnabled" class="form-check-label">Enable Booking</label>
                </div>
            </div>
            <div class="col-md-6">
                <label asp-for="Input.BookingOpensAt" class="form-label">Booking Opens At</label>
                <input asp-for="Input.BookingOpensAt" type="datetime-local" class="form-control" />
            </div>
            <div class="col-md-6">
                <label asp-for="Input.BookingClosesAt" class="form-label">Booking Closes At</label>
                <input asp-for="Input.BookingClosesAt" type="datetime-local" class="form-control" />
            </div>
            <div class="col-md-6">
                <label asp-for="Input.Capacity" class="form-label">Capacity (0 = unlimited)</label>
                <input asp-for="Input.Capacity" type="number" class="form-control" min="0" />
            </div>
            <div class="col-md-6">
                <label asp-for="Input.CancellationDeadline" class="form-label">Cancellation Deadline</label>
                <input asp-for="Input.CancellationDeadline" type="datetime-local" class="form-control" />
            </div>
        </div>
        <div class="mt-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Save</button>
            <a class="btn btn-outline-secondary" asp-page="/Courses/Live/Index" asp-route-id="@session.CourseId">Cancel</a>
        </div>
    </div>
</form>
