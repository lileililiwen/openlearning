@page
@model OpenLearning.Web.Pages.Courses.Live.EditModel
@{
    ViewData["Title"] = "Edit Live Session";
    var course = Model.Course!;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="/Index">Catalog</a></li>
        <li class="breadcrumb-item"><a asp-page="/Courses/Details" asp-route-id="@course.Id">@course.Title</a></li>
        <li class="breadcrumb-item"><a asp-page="/Courses/Live/Index" asp-route-id="@course.Id">Live Sessions</a></li>
        <li class="breadcrumb-item active" aria-current="page">Edit</li>
    </ol>
</nav>

<h1 class="h3 mb-4">Edit Live Session</h1>

<form method="post" class="card shadow-sm">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Input.Title" class="form-label">Title</label>
                <input asp-for="Input.Title" class="form-control" required />
                <span asp-validation-for="Input.Title" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Input.Description" class="form-label">Description (optional)</label>
                <input asp-for="Input.Description" class="form-control" />
            </div>
            <div class="col-md-6">
                <label asp-for="Input.StartsAt" class="form-label">Starts at</label>
                <input asp-for="Input.StartsAt" type="datetime-local" class="form-control" required />
                <span asp-validation-for="Input.StartsAt" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Input.EndsAt" class="form-label">Ends at</label>
                <input asp-for="Input.EndsAt" type="datetime-local" class="form-control" required />
                <span asp-validation-for="Input.EndsAt" class="text-danger small"></span>
            </div>
        </div>
        <div class="mt-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Save changes</button>
            <a class="btn btn-outline-secondary" asp-page="/Courses/Live/Index" asp-route-id="@course.Id">Cancel</a>
        </div>
    </div>
</form>
