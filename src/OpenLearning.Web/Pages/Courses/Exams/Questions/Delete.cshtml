@page
@model OpenLearning.Web.Pages.Courses.Exams.Questions.DeleteModel
@{
    ViewData["Title"] = "Delete Question";
    var question = Model.Question!;
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card shadow-sm border-danger">
            <div class="card-body p-4">
                <h1 class="h4 text-danger mb-3">Delete question</h1>
                <p>Are you sure you want to delete this question?</p>
                <blockquote class="border-start ps-3 text-muted">@question.Text</blockquote>
                <p class="text-muted small">Student answers already recorded for this question will also be removed.</p>

                <form method="post">
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-danger">Delete question</button>
                        <a class="btn btn-outline-secondary" asp-page="/Courses/Exams/Edit" asp-route-id="@question.ExamId">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
