@page
@model OpenLearning.Web.Pages.Courses.Exams.TakeModel
@{
    ViewData["Title"] = Model.Exam!.Title;
    var exam = Model.Exam;
    var questions = exam.Questions.OrderBy(q => q.OrderIndex).ToList();
    var attempt = Model.Attempt;
    var showForm = attempt is not null && questions.Count > 0;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="/Index">Catalog</a></li>
        <li class="breadcrumb-item">
            <a asp-page="/Courses/Details" asp-route-id="@exam.CourseId">@exam.Course!.Title</a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">@exam.Title</li>
    </ol>
</nav>

@if (Model.ErrorMessage is string error)
{
    <div class="alert alert-warning">
        <strong>@exam.Title</strong> is not available to take right now.
        <p class="mb-0 mt-1">@error</p>
    </div>
    <a class="btn btn-outline-secondary" asp-page="/Courses/Details" asp-route-id="@exam.CourseId">Back to course</a>
}
else if (!showForm)
{
    <div class="alert alert-info">This exam has no questions yet. Please check back later.</div>
    <a class="btn btn-outline-secondary" asp-page="/Courses/Details" asp-route-id="@exam.CourseId">Back to course</a>
}
else
{
    <div class="sticky-top bg-white border-bottom shadow-sm mb-3 py-2">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <span class="me-3">
                    <span class="text-muted small">Time remaining</span>
                    <span class="badge bg-dark fs-6 font-monospace" id="countdown">--:--</span>
                </span>
                <span>
                    <span class="text-muted small">Screen switches</span>
                    <span class="badge bg-warning text-dark" id="switch-count">0</span>
                    <span class="text-muted small">/ @OpenLearning.Exams.Services.ExamService.MaxScreenSwitches</span>
                </span>
            </div>
            <div class="small text-muted">
                <span class="badge @(exam.IsOfficial ? "bg-danger" : "bg-secondary")">@(exam.IsOfficial ? "Official" : "Mock") exam</span>
                Pass: @exam.PassPercent% &middot; @exam.MaxAttempts attempt(s) &middot; @exam.DurationMinutes min
            </div>
        </div>
    </div>

    <form method="post" enctype="multipart/form-data" id="exam-form">
        <input type="hidden" asp-for="ExamId" />
        <input type="hidden" asp-for="AttemptId" />
        <input type="hidden" asp-for="ScreenSwitchCount" />
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

        @for (var q = 0; q < questions.Count; q++)
        {
            var question = questions[q];
            <div class="question-screen" @(q == 0 ? "" : "hidden")>
                <div class="card shadow-sm mb-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title mb-0">
                                Question @(q + 1) <span class="text-muted fw-normal">of @questions.Count</span>
                            </h5>
                            <span>
                                <span class="badge bg-light text-dark border me-1">@question.QuestionType</span>
                                <span class="badge bg-secondary">@question.Points pt</span>
                            </span>
                        </div>
                        <p class="mb-3">@question.Text</p>

                        @if (question.QuestionType is OpenLearning.Assessments.Models.QuestionType.SingleChoice or OpenLearning.Assessments.Models.QuestionType.TrueFalse)
                        {
                            foreach (var option in question.AnswerOptions.OrderBy(o => o.OrderIndex))
                            {
                                <div class="form-check mb-1">
                                    <input class="form-check-input" type="radio" name="Answers[@question.Id]"
                                           value="@option.Id" id="q@(question.Id)-o@(option.Id)" />
                                    <label class="form-check-label" for="q@(question.Id)-o@(option.Id)">@option.Text</label>
                                </div>
                            }
                        }
                        else if (question.QuestionType == OpenLearning.Assessments.Models.QuestionType.MultipleChoice)
                        {
                            <p class="text-muted small">Select one or more answers.</p>
                            foreach (var option in question.AnswerOptions.OrderBy(o => o.OrderIndex))
                            {
                                <div class="form-check mb-1">
                                    <input class="form-check-input" type="checkbox" name="Multiple[@question.Id]"
                                           value="@option.Id" id="q@(question.Id)-o@(option.Id)" />
                                    <label class="form-check-label" for="q@(question.Id)-o@(option.Id)">@option.Text</label>
                                </div>
                            }
                        }
                        else if (question.QuestionType == OpenLearning.Assessments.Models.QuestionType.FillBlank)
                        {
                            <input class="form-control" type="text" name="TextAnswers[@question.Id]"
                                   placeholder="Type your answer" />
                        }
                        else if (question.QuestionType == OpenLearning.Assessments.Models.QuestionType.ShortAnswer)
                        {
                            <textarea class="form-control" name="TextAnswers[@question.Id]" rows="4"
                                      placeholder="Write your answer"></textarea>
                        }
                        else if (question.QuestionType == OpenLearning.Assessments.Models.QuestionType.FileUpload)
                        {
                            <input class="form-control" type="file" name="Files[@question.Id]" />
                        }
                    </div>
                </div>

                <div class="d-flex justify-content-between mb-4">
                    <button type="button" class="btn btn-outline-secondary prev-question" @(q == 0 ? "disabled" : "")>
                        &larr; Previous
                    </button>
                    @if (q == questions.Count - 1)
                    {
                        <button type="submit" class="btn btn-primary">Submit exam</button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-primary next-question">Next &rarr;</button>
                    }
                </div>
            </div>
        }
    </form>
}

@section Scripts {
    @if (showForm && attempt is not null)
    {
        <script>
            (function () {
                'use strict';
                var form = document.getElementById('exam-form');
                var switchInput = document.getElementById('@Html.IdFor(m => m.ScreenSwitchCount)');
                var switchBadge = document.getElementById('switch-count');
                var countdownEl = document.getElementById('countdown');
                var maxSwitches = @OpenLearning.Exams.Services.ExamService.MaxScreenSwitches;

                // ----- one question per screen -----
                var screens = Array.prototype.slice.call(document.querySelectorAll('.question-screen'));
                var current = 0;
                function show(index) {
                    current = index;
                    screens.forEach(function (el, i) { el.hidden = i !== current; });
                    window.scrollTo(0, 0);
                }
                screens.forEach(function (el, i) {
                    var prev = el.querySelector('.prev-question');
                    var next = el.querySelector('.next-question');
                    if (prev) { prev.addEventListener('click', function () { show(Math.max(0, i - 1)); }); }
                    if (next) { next.addEventListener('click', function () { show(Math.min(screens.length - 1, i + 1)); }); }
                });

                // ----- countdown -----
                var startedAt = new Date('@attempt!.StartedAt.ToUniversalTime().ToString("o")').getTime();
                var durationMs = @(exam.DurationMinutes * 60) * 1000;
                var deadline = startedAt + durationMs;
                function pad(n) { return n < 10 ? '0' + n : '' + n; }
                function tick() {
                    var remaining = Math.max(0, Math.floor((deadline - Date.now()) / 1000));
                    var h = Math.floor(remaining / 3600);
                    var m = Math.floor((remaining % 3600) / 60);
                    var s = remaining % 60;
                    countdownEl.textContent = (h > 0 ? h + ':' : '') + pad(m) + ':' + pad(s);
                    if (remaining <= 0) {
                        countdownEl.textContent = '0:00';
                        form.submit();
                    } else {
                        setTimeout(tick, 1000);
                    }
                }

                // ----- anti screen-switch -----
                var lastSwitch = 0;
                function addSwitch() {
                    var now = Date.now();
                    if (now - lastSwitch < 500) { return; }
                    lastSwitch = now;
                    var count = parseInt(switchInput.value || '0', 10) + 1;
                    switchInput.value = count;
                    switchBadge.textContent = count;
                    if (count >= maxSwitches) {
                        form.submit();
                    }
                }
                document.addEventListener('visibilitychange', function () { if (document.hidden) { addSwitch(); } });
                window.addEventListener('blur', addSwitch);

                tick();
            })();
        </script>
    }
}
