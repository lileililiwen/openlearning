@page
@model OpenLearning.Web.Pages.Courses.Exams.Integrity.IncidentsModel
@{
    ViewData["Title"] = "Integrity incidents";
}

<h2>Integrity incidents</h2>
<p class="text-muted">Only incidents for courses you own are visible.</p>

@if (Model.Items.Count == 0)
{
    <p class="text-muted">No incidents.</p>
}
else
{
    <table class="table table-sm">
        <thead>
            <tr><th>Id</th><th>Exam</th><th>Student</th><th>Risk</th><th>Score</th><th>Status</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var i in Model.Items)
            {
                <tr>
                    <td>@i.Id</td>
                    <td>@i.ExamId</td>
                    <td>@i.StudentId</td>
                    <td>@i.RiskLevel</td>
                    <td>@i.RiskScore</td>
                    <td>@i.Status</td>
                    <td><a class="btn btn-sm btn-outline-primary" asp-page-handler="" asp-page="/Courses/Exams/Integrity/Incident" asp-route-id="@i.Id">Review</a></td>
                </tr>
            }
        </tbody>
    </table>
}
