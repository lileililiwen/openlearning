@page
@model OpenLearning.Web.Pages.Courses.Modules.CreateModel
@{
    ViewData["Title"] = "Add Module";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <h1 class="h3 mb-4">Add module</h1>

        <form method="post" class="card shadow-sm">
            <div class="card-body p-4">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
                <input type="hidden" asp-for="CourseId" />

                <div class="mb-3">
                    <label asp-for="Input.Title" class="form-label"></label>
                    <input asp-for="Input.Title" class="form-control" autofocus placeholder="e.g. Getting Started" />
                    <span asp-validation-for="Input.Title" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Add module</button>
                    <a class="btn btn-outline-secondary" asp-page="/Courses/Edit" asp-route-id="@Model.CourseId">Cancel</a>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
