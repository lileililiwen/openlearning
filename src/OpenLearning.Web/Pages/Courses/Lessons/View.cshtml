@page
@model OpenLearning.Web.Pages.Courses.Lessons.ViewModel
@inject IStringLocalizer<OpenLearning.Web.Pages.Courses.Lessons.ViewModel> Localizer
@{
    ViewData["Title"] = Model.Lesson!.Title;
    var course = Model.Lesson.Module!.Course!;
    var module = Model.Lesson.Module!;
    var protectionAttrs = Model.IsProtected
        ? "controlsList=\"nodownload noremoteplayback\" disablePictureInPicture oncontextmenu=\"return false;\""
        : string.Empty;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="/Index">@Localizer["Catalog"]</a></li>
        <li class="breadcrumb-item">
            <a asp-page="/Courses/Details" asp-route-id="@course.Id">@course.Title</a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Lesson.Title</li>
    </ol>
</nav>



<div class="row g-4">
    <div class="col-lg-8">
        <article class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h3 mb-1">@Model.Lesson.Title</h1>
                <p class="text-muted small mb-3">@module.Title</p>
                @if (Model.CanTrackProgress)
                {
                    <p class="text-muted small mb-3">@Localizer["Study time: {0}", OpenLearning.Web.Pages.Courses.Lessons.ViewModel.FormatDuration(Model.LessonDurationSeconds)]</p>
                }
                @if (Model.IsVideoLesson)
                {
                    <hr />
                    <div class="position-relative">
                        <div id="danmu-layer" class="danmu-layer"></div>
                        <video id="lesson-video" class="w-100 rounded bg-black" controls playsinline
                               @Html.Raw(protectionAttrs)
                               data-sources="@Json.Serialize(new[] { new { src = Model.Lesson.VideoUrl, label = "Auto" } })"
                               data-protected="@(Model.IsProtected ? "true" : "false")"
                               data-lesson-id="@Model.Lesson.Id"
                               data-course-id="@course.Id"
                               data-danmu="@Json.Serialize(Model.Danmu.Select(d => new { d.UserName, d.Body }))"
                               poster="@Model.Lesson.VideoPosterUrl">
                            @if (!string.IsNullOrWhiteSpace(Model.Lesson.SubtitleUrl))
                            {
                                <track kind="subtitles" src="@Model.Lesson.SubtitleUrl" srclang="en" label="@Localizer["Subtitles"]">
                            }
                        </video>
                    </div>
                    <div class="d-flex flex-wrap gap-2 align-items-center mt-3">
                        <label class="small text-muted mb-0" for="speed-select">@Localizer["Speed"]</label>
                        <select id="speed-select" class="form-select form-select-sm" style="width: auto">
                            <option value="0.5">0.5&times;</option>
                            <option value="0.75">0.75&times;</option>
                            <option value="1" selected>1&times;</option>
                            <option value="1.25">1.25&times;</option>
                            <option value="1.5">1.5&times;</option>
                            <option value="2">2&times;</option>
                        </select>
                        <label class="small text-muted mb-0 ms-2" for="resolution-select">@Localizer["Quality"]</label>
                        <select id="resolution-select" class="form-select form-select-sm" style="width: auto"></select>
                        <button id="cast-button" type="button" class="btn btn-sm btn-outline-secondary ms-auto" style="display: none">@Localizer["Cast"]</button>
                    </div>
                    <div class="d-flex gap-2 mt-3">
                        <input id="danmu-input" class="form-control" maxlength="2000" placeholder="@Localizer["Send a bullet comment…"]" aria-label="@Localizer["Send a bullet comment…"]" />
                        <button id="danmu-send" type="button" class="btn btn-outline-primary">@Localizer["Send"]</button>
                    </div>
                }
                else
                {
                    <hr />
                    @if (string.IsNullOrWhiteSpace(Model.Lesson.Content)
                        && string.IsNullOrWhiteSpace(Model.Lesson.ContentUrlRef))
                    {
                        <div class="alert alert-light border text-muted">@Localizer["No lesson content has been added yet. The instructor can add a video or document on the lesson edit page."]</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Lesson.ContentUrlRef))
                    {
                        <p class="text-muted small">@Localizer["Content reference (text, not embedded):"] <code>@Model.Lesson.ContentUrlRef</code></p>
                    }
                    <div class="lesson-content">
                        @Html.Raw(MarkdownRenderer.ToHtml(Model.Lesson.Content))
                    </div>
                }
            </div>
        </article>

        @if (Model.ScormPackage is not null)
        {
            <div class="mt-3">
                <a class="btn btn-primary" asp-page="/Courses/Lessons/Scorm/Launch" asp-route-id="@Model.Lesson.Id">
                    @Localizer["Launch SCORM content"]
                </a>
            </div>
        }

        @if (Model.CanTrackProgress)
        {
            <div id="lesson-actions">
                <partial name="_LessonActions" model="Model" />
            </div>
        }

        @if (Model.CanTrackProgress)
        {
            <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mt-3">
                <div class="d-flex gap-2">
                    @if (Model.PrevLessonId is { } prevId)
                    {
                        <a class="btn btn-outline-secondary" asp-page="/Courses/Lessons/View" asp-route-id="@prevId">
                            &laquo; @Localizer["Previous"]
                        </a>
                    }
                    @if (Model.NextLessonId is { } nextId)
                    {
                        <a class="btn btn-outline-primary" asp-page="/Courses/Lessons/View" asp-route-id="@nextId">
                            @Localizer["Next"] &raquo;
                        </a>
                    }
                </div>
                <form method="post" asp-page-handler="CompleteAndNext" asp-route-id="@Model.Lesson.Id" class="d-inline">
                    <button type="submit" class="btn btn-success">
                        @Localizer["Complete & Next"]
                    </button>
                </form>
            </div>
        }
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <partial name="_CurriculumSidebar" model="(Model.Curriculum, Model.Lesson.Id)" />
                <a class="btn btn-outline-primary w-100 mt-3" asp-page="/Courses/Details" asp-route-id="@course.Id">
                    @Localizer["Back to course"]
                </a>
            </div>
        </div>

        @if (Model.AssessmentLinkUrl is not null)
        {
            <div class="card shadow-sm mt-3">
                <div class="card-body">
                    <h2 class="h6">@Localizer["Assessment"]</h2>
                    <a class="btn btn-outline-primary w-100" href="@Model.AssessmentLinkUrl">@Model.AssessmentLinkLabel</a>
                </div>
            </div>
        }

        @if (Model.Downloads.Count > 0)
        {
            <div class="card shadow-sm mt-3">
                <div class="card-body">
                    <h2 class="h6">@Localizer["Downloads"]</h2>
                    <ul class="list-unstyled mb-0">
                        @foreach (var download in Model.Downloads)
                        {
                            <li class="mb-1"><a href="@download.FileUrl" target="_blank" rel="noopener">@download.Label</a></li>
                        }
                    </ul>
                </div>
            </div>
        }
    </div>
</div>

@if (Model.CanTrackProgress)
{
    <script>
        // Study-duration session: start on load, heartbeat while visible, end on hide/close.
        (function () {
            const courseId = @course.Id;
            const lessonId = @Model.Lesson.Id;
            const heartbeatMs = 60000;
            let sessionId = null;

            async function post(url, body) {
                try {
                    const response = await fetch(url, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(body)
                    });
                    return await response.json();
                } catch (e) {
                    return null;
                }
            }

            async function start() {
                const data = await post('/progress/session/start', { courseId, lessonId });
                if (data && data.sessionId) {
                    sessionId = data.sessionId;
                }
            }

            async function heartbeat() {
                if (sessionId === null) return;
                await post('/progress/session/heartbeat', { sessionId });
            }

            async function end() {
                if (sessionId === null) return;
                await post('/progress/session/end', { sessionId });
                sessionId = null;
            }

            start();
            setInterval(heartbeat, heartbeatMs);
            document.addEventListener('visibilitychange', () => {
                if (document.visibilityState === 'hidden') end();
            });
            window.addEventListener('pagehide', end);
        })();
    </script>
}

@section Scripts {
    @if (Model.IsVideoLesson)
    {
        <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@@8.0.7/dist/browser/signalr.min.js"></script>
        <script src="~/js/media-player.js" asp-append-version="true"></script>
    }
}
