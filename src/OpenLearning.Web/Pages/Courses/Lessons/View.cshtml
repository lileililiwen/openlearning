@page
@model OpenLearning.Web.Pages.Courses.Lessons.ViewModel
@{
    ViewData["Title"] = Model.Lesson!.Title;
    var course = Model.Lesson.Module!.Course!;
    var module = Model.Lesson.Module!;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="/Index">Catalog</a></li>
        <li class="breadcrumb-item">
            <a asp-page="/Courses/Details" asp-route-id="@course.Id">@course.Title</a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Lesson.Title</li>
    </ol>
</nav>

<div class="row g-4">
    <div class="col-lg-8">
        <article class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h3 mb-1">@Model.Lesson.Title</h1>
                <p class="text-muted small mb-3">@module.Title</p>
                @if (Model.CanTrackProgress)
                {
                    <p class="text-muted small mb-3">Study time: @OpenLearning.Web.Pages.Courses.Lessons.ViewModel.FormatDuration(Model.LessonDurationSeconds)</p>
                }
                <hr />
                <div class="lesson-content">
                    @Html.Raw(MarkdownRenderer.ToHtml(Model.Lesson.Content))
                </div>
            </div>
        </article>

        @if (Model.ScormPackage is not null)
        {
            <div class="mt-3">
                <a class="btn btn-primary" asp-page="/Courses/Lessons/Scorm/Launch" asp-route-id="@Model.Lesson.Id">
                    Launch SCORM content
                </a>
            </div>
        }

        @if (Model.CanTrackProgress)
        {
            <div class="mt-3">
                @if (Model.IsCompleted)
                {
                    <form method="post" asp-page-handler="Uncomplete" asp-route-id="@Model.Lesson.Id">
                        <button type="submit" class="btn btn-outline-warning">
                            &#10003; Mark as not completed
                        </button>
                    </form>
                }
                else
                {
                    <form method="post" asp-page-handler="Complete" asp-route-id="@Model.Lesson.Id">
                        <button type="submit" class="btn btn-success">Mark as completed</button>
                    </form>
                }
            </div>
        }
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <h2 class="h6">Module lessons</h2>
                <ul class="list-unstyled mb-3">
                    @foreach (var lesson in Model.ModuleLessons)
                    {
                        <li class="mb-1">
                            @if (lesson.Id == Model.Lesson.Id)
                            {
                                <span class="fw-semibold">&#9656; @lesson.Title</span>
                            }
                            else
                            {
                                <a asp-page="/Courses/Lessons/View" asp-route-id="@lesson.Id">@lesson.Title</a>
                            }
                        </li>
                    }
                </ul>
                <a class="btn btn-outline-primary w-100" asp-page="/Courses/Details" asp-route-id="@course.Id">
                    Back to course
                </a>
            </div>
        </div>
    </div>
</div>

@if (Model.CanTrackProgress)
{
    <script>
        // Study-duration session: start on load, heartbeat while visible, end on hide/close.
        (function () {
            const courseId = @course.Id;
            const lessonId = @Model.Lesson.Id;
            const heartbeatMs = 60000;
            let sessionId = null;

            async function post(url, body) {
                try {
                    const response = await fetch(url, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(body)
                    });
                    return await response.json();
                } catch (e) {
                    return null;
                }
            }

            async function start() {
                const data = await post('/progress/session/start', { courseId, lessonId });
                if (data && data.sessionId) {
                    sessionId = data.sessionId;
                }
            }

            async function heartbeat() {
                if (sessionId === null) return;
                await post('/progress/session/heartbeat', { sessionId });
            }

            async function end() {
                if (sessionId === null) return;
                await post('/progress/session/end', { sessionId });
                sessionId = null;
            }

            start();
            setInterval(heartbeat, heartbeatMs);
            document.addEventListener('visibilitychange', () => {
                if (document.visibilityState === 'hidden') end();
            });
            window.addEventListener('pagehide', end);
        })();
    </script>
}
