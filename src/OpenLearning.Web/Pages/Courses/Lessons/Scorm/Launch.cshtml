@page
@using System.Text.Json
@model OpenLearning.Web.Pages.Courses.Lessons.Scorm.LaunchModel
@{
    ViewData["Title"] = Model.Lesson!.Title;
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Model.Lesson.Title — SCORM</title>
    <style>
        html, body { margin: 0; height: 100%; }
        #sco { width: 100%; height: 100vh; border: 0; display: block; }
        #loading {
            position: fixed; inset: 0; display: flex; align-items: center;
            justify-content: center; font-family: sans-serif; color: #6c757d; background: #f8f9fa; z-index: 10;
        }
    </style>
</head>
<body>
    <div id="loading">Loading SCORM content…</div>
    <iframe id="sco" src="@Model.ScormUrl" allowfullscreen></iframe>

    <script>
        window.scormConfig = @Html.Raw(JsonSerializer.Serialize(new
        {
            packageId = Model.Package!.Id,
            studentId = Model.StudentId,
            studentName = Model.StudentName,
        }));
    </script>
    <script src="~/js/scorm-api.js"></script>
    <script>
        // Hide the loading overlay once the SCO frame has started loading.
        window.addEventListener("load", function () {
            var el = document.getElementById("loading");
            if (el) { el.style.display = "none"; }
        });
        document.getElementById("sco").addEventListener("load", function () {
            var el = document.getElementById("loading");
            if (el) { el.style.display = "none"; }
        });
    </script>
</body>
</html>
