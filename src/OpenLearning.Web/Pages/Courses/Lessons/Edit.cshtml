@page
@model OpenLearning.Web.Pages.Courses.Lessons.EditModel
@{
    ViewData["Title"] = "Edit Lesson";
    var lesson = Model.Lesson!;
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <h1 class="h3 mb-4">Edit lesson</h1>

        <form method="post" class="card shadow-sm">
            <div class="card-body p-4">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label asp-for="Input.Title" class="form-label"></label>
                    <input asp-for="Input.Title" class="form-control" autofocus />
                    <span asp-validation-for="Input.Title" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.Content" class="form-label"></label>
                    <textarea asp-for="Input.Content" class="form-control" rows="12"
                              placeholder="Supports Markdown: **bold**, _italic_, `code`, lists, links..."></textarea>
                    <span asp-validation-for="Input.Content" class="text-danger small"></span>
                </div>

                <div class="card bg-light mb-3">
                    <div class="card-body">
                        <h2 class="h6">Video (optional)</h2>
                        <p class="text-muted small mb-3">
                            Paste URLs for a stored video (<code>/files/video/...</code>), a poster image, and an optional WebVTT subtitle track. When a video URL is set, students see the player instead of the text content.
                        </p>
                        <div class="mb-3">
                            <label asp-for="Input.VideoUrl" class="form-label"></label>
                            <div class="input-group">
                                <input asp-for="Input.VideoUrl" class="form-control" placeholder="/files/video/..." />
                                <button type="button" class="btn btn-outline-secondary" onclick="openResourcePicker('Input_VideoUrl', 'video')">从资源库选择</button>
                            </div>
                            <span asp-validation-for="Input.VideoUrl" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Input.VideoPosterUrl" class="form-label"></label>
                            <div class="input-group">
                                <input asp-for="Input.VideoPosterUrl" class="form-control" placeholder="/files/image/..." />
                                <button type="button" class="btn btn-outline-secondary" onclick="openResourcePicker('Input_VideoPosterUrl', 'image')">从资源库选择</button>
                            </div>
                            <span asp-validation-for="Input.VideoPosterUrl" class="text-danger small"></span>
                        </div>
                        <div class="mb-0">
                            <label asp-for="Input.SubtitleUrl" class="form-label"></label>
                            <div class="input-group">
                                <input asp-for="Input.SubtitleUrl" class="form-control" placeholder="/files/subtitles/en.vtt" />
                                <button type="button" class="btn btn-outline-secondary" onclick="openResourcePicker('Input_SubtitleUrl', 'document')">从资源库选择</button>
                            </div>
                            <span asp-validation-for="Input.SubtitleUrl" class="text-danger small"></span>
                        </div>
                        @await Html.PartialAsync("_ResourcePicker")
                    </div>
                </div>

                <div class="form-check mb-3">
                    <input asp-for="Input.IsPreview" class="form-check-input" />
                    <label asp-for="Input.IsPreview" class="form-check-label small text-muted"></label>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Save changes</button>
                    <a class="btn btn-outline-secondary"
                       asp-page="/Courses/Edit"
                       asp-route-id="@(lesson.Module?.CourseId)">Cancel</a>
                </div>
            </div>
        </form>

        <div class="card shadow-sm mt-4">
            <div class="card-header bg-white">
                <strong>SCORM content</strong>
            </div>
            <div class="card-body">
                @if (Model.ScormPackage is not null)
                {
                    <p class="mb-2">
                        Attached package: <strong>@Model.ScormPackage.Title</strong>
                        <span class="text-muted small">(@Model.ScormPackage.ScormVersion · @Model.ScormPackage.EntryPoint)</span>
                    </p>
                    <form method="post" asp-page-handler="RemoveScorm" asp-route-id="@lesson.Id"
                          onsubmit="return confirm('Remove this SCORM package?');">
                        <button type="submit" class="btn btn-outline-danger btn-sm">Remove package</button>
                    </form>
                }
                else
                {
                    <p class="text-muted small mb-3">
                        Upload a SCORM 1.2 package (.zip with imsmanifest.xml) to make this lesson
                        launchable SCORM content.
                    </p>
                    <form method="post" asp-page-handler="UploadScorm" asp-route-id="@lesson.Id"
                          enctype="multipart/form-data">
                        <div class="d-flex gap-2 align-items-center">
                            <input type="file" name="ScormFile" accept=".zip,application/zip" class="form-control" />
                            <button type="submit" class="btn btn-primary">Upload</button>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
