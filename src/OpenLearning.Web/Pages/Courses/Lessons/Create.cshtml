@page
@model OpenLearning.Web.Pages.Courses.Lessons.CreateModel
@{
    ViewData["Title"] = "Add Lesson";
    var module = Model.Module!;
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <h1 class="h3 mb-4">Add lesson to @module.Title</h1>

        <form method="post" class="card shadow-sm">
            <div class="card-body p-4">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
                <input type="hidden" asp-for="ModuleId" />

                <div class="mb-3">
                    <label asp-for="Input.Title" class="form-label"></label>
                    <input asp-for="Input.Title" class="form-control" autofocus />
                    <span asp-validation-for="Input.Title" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.Content" class="form-label"></label>
                    <textarea asp-for="Input.Content" class="form-control" rows="12"
                              placeholder="Supports Markdown: **bold**, _italic_, `code`, lists, links..."></textarea>
                    <span asp-validation-for="Input.Content" class="text-danger small"></span>
                </div>

                <div class="card bg-light mb-3">
                    <div class="card-body">
                        <h2 class="h6">Video (optional)</h2>
                        <p class="text-muted small mb-3">
                            Paste URLs for a stored video (<code>/files/video/...</code>), a poster image, and an optional WebVTT subtitle track. When a video URL is set, students see the player instead of the text content.
                        </p>
                        <div class="mb-3">
                            <label asp-for="Input.VideoUrl" class="form-label"></label>
                            <input asp-for="Input.VideoUrl" class="form-control" placeholder="/files/video/..." />
                            <span asp-validation-for="Input.VideoUrl" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Input.VideoPosterUrl" class="form-label"></label>
                            <input asp-for="Input.VideoPosterUrl" class="form-control" placeholder="/files/image/..." />
                            <span asp-validation-for="Input.VideoPosterUrl" class="text-danger small"></span>
                        </div>
                        <div class="mb-0">
                            <label asp-for="Input.SubtitleUrl" class="form-label"></label>
                            <input asp-for="Input.SubtitleUrl" class="form-control" placeholder="/files/subtitles/en.vtt" />
                            <span asp-validation-for="Input.SubtitleUrl" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <div class="form-check mb-3">
                    <input asp-for="Input.IsPreview" class="form-check-input" />
                    <label asp-for="Input.IsPreview" class="form-check-label small text-muted"></label>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Add lesson</button>
                    <a class="btn btn-outline-secondary"
                       asp-page="/Courses/Edit"
                       asp-route-id="@(module.CourseId)">Cancel</a>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
