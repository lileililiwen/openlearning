@page
@model OpenLearning.Web.Pages.Courses.Reviews.IndexModel
@{
    ViewData["Title"] = "Course Reviews";
    var aggregate = Model.Aggregate;
}

<div class="d-flex justify-content-between align-items-end mb-4">
    <div>
        <h1 class="h3 mb-1">Reviews — @Model.CourseTitle</h1>
        <p class="text-muted mb-0">All student ratings and written reviews.</p>
    </div>
    <a class="btn btn-outline-primary" asp-page="/Courses/Details" asp-route-id="@Model.CourseId">Back to course</a>
</div>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-@(TempData["MessageType"] ?? "success") alert-dismissible fade show" role="alert">
        @message
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm mb-4">
    <div class="card-body">
        @if (aggregate.Count == 0)
        {
            <p class="text-muted mb-0">No reviews yet.</p>
        }
        else
        {
            <div class="d-flex align-items-baseline gap-2">
                <span class="display-6 fw-semibold mb-0">@aggregate.Average.ToString("0.0")</span>
                <span class="text-muted">/ 5 from @aggregate.Count review@(aggregate.Count == 1 ? "" : "s")</span>
            </div>
        }
    </div>
</div>

@if (Model.Reviews.Count == 0)
{
    <div class="alert alert-info">No students have reviewed this course yet.</div>
}
else
{
    <div class="card shadow-sm">
        <ul class="list-group list-group-flush">
            @foreach (var review in Model.Reviews)
            {
                    <li class="list-group-item">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <div>
                                <strong>@review.AuthorName</strong>
                                <span class="text-muted small ms-2">@(review.AuthorEmail ?? "—")</span>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                @{
                                    var stars = new System.Text.StringBuilder();
                                    stars.Append('★', review.Rating);
                                    stars.Append('☆', 5 - review.Rating);
                                }
                                <span class="text-warning">@stars.ToString()</span>
                                <span class="text-muted small">@review.CreatedAt.ToString("yyyy-MM-dd")</span>
                            </div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(review.Comment))
                        {
                            <p class="mb-0 mt-2">@review.Comment</p>
                        }
                        @if (User.IsInRole("Admin"))
                        {
                            <form method="post" asp-page-handler="Remove" asp-route-id="@Model.CourseId" asp-route-reviewId="@review.Id" class="mt-2"
                                  onsubmit="return confirm('Remove this review?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                            </form>
                        }
                    </li>
            }
        </ul>
    </div>
}
