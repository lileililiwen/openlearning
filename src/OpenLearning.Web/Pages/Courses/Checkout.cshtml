@page
@model OpenLearning.Web.Pages.Courses.CheckoutModel
@{
    ViewData["Title"] = "Checkout";
    var order = Model.Order!;
    var course = order.Course!;
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h4 mb-1">Checkout</h1>
                <p class="text-muted small mb-4">Demo checkout — no real payment is processed.</p>

                <div class="d-flex justify-content-between border-bottom pb-3 mb-3">
                    <span>
                        <strong>@course.Title</strong>
                        <span class="d-block text-muted small">One-time purchase · lifetime access</span>
                    </span>
                    <span class="fs-5 fw-semibold">@order.Amount.ToString("C")</span>
                </div>

                <div class="d-flex justify-content-between mb-4">
                    <span class="text-muted">Total</span>
                    <span class="fs-5 fw-semibold">@order.Amount.ToString("C")</span>
                </div>

                <form method="post" asp-route-orderId="@order.Id">
                    <button type="submit" class="btn btn-success w-100 mb-2">Pay @order.Amount.ToString("C") (demo)</button>
                </form>
                <a class="btn btn-outline-secondary w-100" asp-page="/Courses/Details" asp-route-id="@course.Id">Cancel</a>
            </div>
        </div>
    </div>
</div>
