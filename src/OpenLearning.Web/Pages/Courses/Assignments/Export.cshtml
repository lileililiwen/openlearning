@page
@model OpenLearning.Web.Pages.Courses.Assignments.ExportModel
@{
    ViewData["Title"] = "导出提交";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">导出提交</h1>
    <div>
        <a class="btn btn-outline-secondary btn-sm" asp-page="/Courses/Assignments/Submissions" asp-route-id="@Model.AssignmentId">返回提交列表</a>
        <a class="btn btn-outline-secondary btn-sm" asp-page="/GradeExport/Jobs">查看导出任务</a>
    </div>
</div>

@if (Model.Assignment is not null)
{
    <p class="text-muted small">
        作业：<strong>@Model.Assignment.Title</strong>（@Model.CourseTitle）。超过 1000 行时自动转为异步导出，完成后通过站内信通知。
    </p>
}

@if (Model.JobId is not null)
{
    <div class="alert alert-success">
        文件正在生成，完成后将通过站内信通知。
        <a asp-page="/GradeExport/Jobs">查看导出任务</a>
    </div>
}

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<div class="card shadow-sm">
    <div class="card-header bg-white"><strong>按条件导出</strong></div>
    <div class="card-body">
        <form method="post">
            <input type="hidden" name="CourseId" value="@Model.CourseId" />
            <input type="hidden" name="AssignmentId" value="@Model.AssignmentId" />
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label" asp-for="From">开始日期</label>
                    <input asp-for="From" type="date" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label" asp-for="To">结束日期</label>
                    <input asp-for="To" type="date" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label" asp-for="Status">批改状态</label>
                    <select asp-for="Status" class="form-select">
                        <option value="">全部</option>
                        <option value="graded">已批改</option>
                        <option value="ungraded">未批改</option>
                    </select>
                </div>
            </div>
            <button type="submit" class="btn btn-primary mt-3">导出 Excel</button>
        </form>
    </div>
</div>
