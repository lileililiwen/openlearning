@page
@model OpenLearning.Web.Pages.Courses.Assignments.CreateModel
@{
    ViewData["Title"] = "New Assignment";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h4 mb-4">New assignment</h1>
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
                    <div class="mb-3">
                        <label asp-for="Input.Title" class="form-label"></label>
                        <input asp-for="Input.Title" class="form-control" autofocus />
                        <span asp-validation-for="Input.Title" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.Instructions" class="form-label"></label>
                        <textarea asp-for="Input.Instructions" class="form-control" rows="8"></textarea>
                        <span asp-validation-for="Input.Instructions" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.DueAt" class="form-label">Due date (optional)</label>
                        <input asp-for="Input.DueAt" type="datetime-local" class="form-control" />
                    </div>
                    <div class="form-check mb-4">
                        <input asp-for="Input.AllowResubmitAfterGrading" class="form-check-input" />
                        <label asp-for="Input.AllowResubmitAfterGrading" class="form-check-label small">
                            Allow resubmission after grading
                        </label>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Create</button>
                        <a class="btn btn-outline-secondary" asp-page="/Courses/Assignments/Index" asp-route-courseId="@Model.CourseId">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
