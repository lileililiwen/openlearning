@page
@model OpenLearning.Web.Pages.Courses.Assignments.IndexModel
@{
    ViewData["Title"] = "Assignments · " + (Model.Course?.Title ?? "");
    var course = Model.Course;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="/Index">Catalog</a></li>
        <li class="breadcrumb-item"><a asp-page="/Courses/Details" asp-route-id="@course?.Id">@course?.Title</a></li>
        <li class="breadcrumb-item active">Assignments</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Assignments</h1>
        <p class="text-muted mb-0">Course work with manual grading.</p>
    </div>
    @if (Model.IsOwner)
    {
        <a class="btn btn-primary" asp-page="/Courses/Assignments/Create" asp-route-courseId="@course?.Id">New assignment</a>
    }
</div>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-@(TempData["MessageType"] ?? "success") alert-dismissible fade show" role="alert">
        @message
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (Model.Assignments.Count == 0)
{
    <div class="alert alert-info">No assignments for this course yet.</div>
}
else
{
    <div class="row g-4">
        @foreach (var assignment in Model.Assignments)
        {
            var submission = Model.Submissions.GetValueOrDefault(assignment.Id);
            var isGraded = submission?.GradedAt is not null;
            <div class="col-lg-6">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h5 class="card-title mb-1">
                            <a class="text-decoration-none" asp-page="/Courses/Assignments/Detail" asp-route-id="@assignment.Id">@assignment.Title</a>
                        </h5>
                        <div class="text-muted small mb-2">
                            Due: @(assignment.DueAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "No due date")
                        </div>
                        <p class="card-text">
                            @(assignment.Instructions.Length > 160 ? assignment.Instructions[..160] + "…" : assignment.Instructions)
                        </p>
                        @if (submission is not null)
                        {
                            if (isGraded)
                            {
                                <span class="badge bg-success">Graded: @submission.Score/100</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Submitted — pending grading</span>
                            }
                        }
                        else
                        {
                            <span class="badge bg-secondary">Not submitted</span>
                        }
                    </div>
                    <div class="card-footer bg-transparent">
                        @if (Model.IsOwner)
                        {
                            <div class="d-flex gap-2">
                                <a class="btn btn-sm btn-outline-primary" asp-page="/Courses/Assignments/Submissions" asp-route-id="@assignment.Id">
                                    Submissions (@Model.UngradedCounts.GetValueOrDefault(assignment.Id) pending)
                                </a>
                                <a class="btn btn-sm btn-outline-secondary" asp-page="/Courses/Assignments/Edit" asp-route-id="@assignment.Id">Edit</a>
                            </div>
                        }
                        else if (Model.IsEnrolled)
                        {
                            <a class="btn btn-sm btn-primary" asp-page="/Courses/Assignments/Detail" asp-route-id="@assignment.Id">
                                @(OpenLearning.Web.Pages.Courses.Assignments.IndexModel.ActionLabel(assignment.Id, submission))
                            </a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
