@page
@model OpenLearning.Web.Pages.Courses.CreateModel
@{
    ViewData["Title"] = "New Course";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <h1 class="h3 mb-4">Create a course</h1>

        <form method="post" class="card shadow-sm">
            <div class="card-body p-4">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Input.Title" class="form-label"></label>
                    <input asp-for="Input.Title" class="form-control" autofocus />
                    <span asp-validation-for="Input.Title" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.Category" class="form-label"></label>
                    <input asp-for="Input.Category" class="form-control" placeholder="e.g. Programming, Design, Data Science" />
                    <span asp-validation-for="Input.Category" class="text-danger small"></span>
                </div>
                <div class="mb-3" style="max-width: 220px">
                    <label asp-for="Input.Price" class="form-label"></label>
                    <input asp-for="Input.Price" class="form-control" placeholder="Free" />
                    <span asp-validation-for="Input.Price" class="text-danger small"></span>
                    <div class="form-text">Set a price to sell this course. Leave blank for a free course.</div>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.Description" class="form-label"></label>
                    <textarea asp-for="Input.Description" class="form-control" rows="6"></textarea>
                    <span asp-validation-for="Input.Description" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Create course</button>
                    <a class="btn btn-outline-secondary" asp-page="/Courses/Manage">Cancel</a>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
