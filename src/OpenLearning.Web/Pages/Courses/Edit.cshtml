@page
@model OpenLearning.Web.Pages.Courses.EditModel
@{
    ViewData["Title"] = "Edit Course";
    var course = Model.Course!;
}

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">Edit course</h1>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-primary" asp-page="/Courses/Roster/Index" asp-route-id="@course.Id">Roster</a>
            <a class="btn btn-outline-primary" asp-page="/Courses/Details" asp-route-id="@course.Id">View course page</a>
        </div>
    </div>

<form method="post" class="card shadow-sm mb-4">
    <div class="card-body p-4">
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

        <div class="mb-3">
            <label asp-for="Input.Title" class="form-label"></label>
            <input asp-for="Input.Title" class="form-control" autofocus />
            <span asp-validation-for="Input.Title" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Input.Category" class="form-label"></label>
            <input asp-for="Input.Category" class="form-control" />
            <span asp-validation-for="Input.Category" class="text-danger small"></span>
        </div>
        <div class="mb-3" style="max-width: 220px">
            <label asp-for="Input.Price" class="form-label"></label>
            <input asp-for="Input.Price" class="form-control" placeholder="Free" />
            <span asp-validation-for="Input.Price" class="text-danger small"></span>
            <div class="form-text">Set a price to sell this course. Leave blank for a free course.</div>
        </div>
        <div class="mb-3">
            <label asp-for="Input.Description" class="form-label"></label>
            <textarea asp-for="Input.Description" class="form-control" rows="5"></textarea>
            <span asp-validation-for="Input.Description" class="text-danger small"></span>
        </div>

        <hr class="my-4" />
        <h2 class="h6 text-muted">Course details</h2>

        <div class="row g-3 mb-3">
            <div class="col-md-4">
                <label asp-for="Input.Level" class="form-label"></label>
                <select asp-for="Input.Level" class="form-select">
                    <option value="">Any level</option>
                    @foreach (var level in Enum.GetValues<CourseLevel>())
                    {
                        <option value="@((int)level)">@level</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label asp-for="Input.Duration" class="form-label"></label>
                <input asp-for="Input.Duration" class="form-control" placeholder="6 hours" />
                <span asp-validation-for="Input.Duration" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Input.Language" class="form-label"></label>
                <input asp-for="Input.Language" class="form-control" placeholder="English" />
                <span asp-validation-for="Input.Language" class="text-danger small"></span>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Input.Prerequisites" class="form-label"></label>
            <textarea asp-for="Input.Prerequisites" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Input.Prerequisites" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Input.LearningOutcomes" class="form-label"></label>
            <textarea asp-for="Input.LearningOutcomes" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Input.LearningOutcomes" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Input.Tags" class="form-label"></label>
            <input asp-for="Input.Tags" class="form-control" placeholder="csharp, beginner, web" />
            <span asp-validation-for="Input.Tags" class="text-danger small"></span>
            <div class="form-text">Comma-separated tags. Unknown tags are created automatically.</div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Save changes</button>
            <a class="btn btn-outline-secondary" asp-page="/Courses/Manage">Back to my courses</a>
        </div>
    </div>
</form>

<div class="card shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <strong>Course structure</strong>
        <a class="btn btn-sm btn-primary" asp-page="/Courses/Modules/Create" asp-route-courseId="@course.Id">Add module</a>
    </div>
    <ul class="list-group list-group-flush">
        @if (course.Modules.Count == 0)
        {
            <li class="list-group-item text-muted">
                No modules yet. Add a module to start organizing lessons.
            </li>
        }
        else
        {
            foreach (var module in course.Modules)
            {
                <li class="list-group-item">
                    <div class="d-flex justify-content-between align-items-center">
                        <strong>@module.Title</strong>
                        <span class="d-inline-flex gap-2">
                            <a class="btn btn-sm btn-outline-primary" asp-page="/Courses/Lessons/Create" asp-route-moduleId="@module.Id">Add lesson</a>
                            <a class="btn btn-sm btn-outline-secondary" asp-page="/Courses/Modules/Edit" asp-route-id="@module.Id">Edit</a>
                            <a class="btn btn-sm btn-outline-danger" asp-page="/Courses/Modules/Delete" asp-route-id="@module.Id">Delete</a>
                        </span>
                    </div>
                    @if (module.Lessons.Count > 0)
                    {
                        <ul class="list-unstyled ms-3 mt-2 mb-0 small">
                            @foreach (var lesson in module.Lessons)
                            {
                                <li class="d-flex justify-content-between align-items-center py-1">
                                    <span>@lesson.Title</span>
                                    <span class="d-inline-flex gap-2">
                                        <a class="btn btn-sm btn-outline-secondary" asp-page="/Courses/Lessons/Edit" asp-route-id="@lesson.Id">Edit</a>
                                        <a class="btn btn-sm btn-outline-danger" asp-page="/Courses/Lessons/Delete" asp-route-id="@lesson.Id">Delete</a>
                                    </span>
                                </li>
                            }
                        </ul>
                    }
                </li>
            }
        }
    </ul>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-white">
        <strong>Course announcements</strong>
    </div>
    <div class="card-body">
        @if (TempData["Message"] is string message)
        {
            <div class="alert alert-@(TempData["MessageType"] ?? "success") alert-dismissible fade show" role="alert">
                @message
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        <form method="post" asp-page-handler="Announce" asp-route-id="@course.Id" class="mb-3">
            <label class="form-label small text-muted mb-1" asp-for="AnnouncementBody">Post an announcement</label>
            <textarea asp-for="AnnouncementBody" class="form-control" rows="2" maxlength="4000"
                      placeholder="Message all enrolled students…"></textarea>
            <button type="submit" class="btn btn-primary btn-sm mt-2">Post announcement</button>
        </form>
        @if (Model.Announcements.Count == 0)
        {
            <p class="text-muted small mb-0">No announcements yet.</p>
        }
        else
        {
            <ul class="list-group list-group-flush">
                @foreach (var announcement in Model.Announcements)
                {
                    <li class="list-group-item px-0">
                        <div class="small">@announcement.Body</div>
                        <div class="text-muted small">@announcement.CreatedAt.ToString("yyyy-MM-dd HH:mm")</div>
                    </li>
                }
            </ul>
        }
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <strong>Quizzes (@Model.Quizzes.Count)</strong>
        <a class="btn btn-sm btn-primary" asp-page="/Courses/Quizzes/Create" asp-route-courseId="@course.Id">Add quiz</a>
    </div>
    <ul class="list-group list-group-flush">
        @if (Model.Quizzes.Count == 0)
        {
            <li class="list-group-item text-muted">
                No quizzes yet. Add a quiz to assess your students.
            </li>
        }
        else
        {
            foreach (var quiz in Model.Quizzes)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <div>
                        <strong>@quiz.Title</strong>
                        <span class="text-muted small ms-2">@quiz.Questions.Count question(s)</span>
                    </div>
                    <span class="d-inline-flex gap-2">
                        <a class="btn btn-sm btn-outline-primary" asp-page="/Courses/Quizzes/Results" asp-route-id="@quiz.Id">Results</a>
                        <a class="btn btn-sm btn-outline-secondary" asp-page="/Courses/Quizzes/Edit" asp-route-id="@quiz.Id">Edit</a>
                        <a class="btn btn-sm btn-outline-danger" asp-page="/Courses/Quizzes/Delete" asp-route-id="@quiz.Id">Delete</a>
                    </span>
                </li>
            }
        }
    </ul>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
