@page
@model OpenLearning.Web.Pages.Gamification.ManageModel
@{ ViewData["Title"] = "Gamification administration"; }
<h1>@ViewData["Title"]</h1>
<section><h2>Point rules</h2><form method="post" asp-page-handler="Rule"><input name="name" required maxlength="200" placeholder="Rule name" /><input name="eventType" required maxlength="100" placeholder="Trusted event type" /><input name="points" type="number" min="1" required /><input name="dailyCap" type="number" min="1" required /><button>Create version</button></form><ul>@foreach (var rule in Model.Rules) { <li>#@rule.Id @rule.EventType v@rule.Version: @rule.Points points, cap @rule.DailyCap, enabled @rule.IsEnabled <form method="post" asp-page-handler="RuleState"><input type="hidden" name="id" value="@rule.Id" /><button name="enabled" value="@(!rule.IsEnabled)">@(rule.IsEnabled ? "Disable" : "Enable")</button></form></li> }</ul></section>
<section><h2>Badges</h2><form method="post" asp-page-handler="Badge"><input name="key" required maxlength="100" /><input name="name" required maxlength="200" /><input name="requiredPoints" type="number" min="1" required /><label><input name="publish" type="checkbox" value="true" /> Publish</label><button>Create version</button></form><ul>@foreach (var badge in Model.Badges) { <li>@badge.Key v@badge.CriteriaVersion — @badge.RequiredPoints points — published @badge.IsPublished</li> }</ul></section>
<section><h2>Challenges</h2><form method="post" asp-page-handler="Challenge"><input name="name" required maxlength="200" /><input name="startsAt" type="datetime-local" required /><input name="endsAt" type="datetime-local" required /><input name="targetPoints" type="number" min="1" required /><select name="scopeKind" asp-items="Html.GetEnumSelectList<OpenLearning.Gamification.Models.GamificationScopeKind>()"></select><input name="scopeId" maxlength="100" placeholder="platform ignores scope id" /><button>Create</button></form></section>
<section><h2>Preview or run backfill</h2><form method="post" asp-page-handler="Backfill"><input name="ruleId" type="number" min="1" required /><textarea name="events" required placeholder="userId|sourceKey, one per line"></textarea><select name="scopeKind" asp-items="Html.GetEnumSelectList<OpenLearning.Gamification.Models.GamificationScopeKind>()"></select><input name="scopeId" maxlength="100" /><button name="preview" value="true">Preview</button><button name="preview" value="false">Run</button></form></section>
<section><h2>Audit correction</h2><form method="post" asp-page-handler="Correction"><input name="entryId" type="number" min="1" required /><input name="correctedAmount" type="number" required /><input name="reason" required maxlength="500" /><button>Record correction</button></form></section>
<section><h2>Leaderboard moderation</h2><form method="post" asp-page-handler="Moderation"><input name="userId" required /><select name="scopeKind" asp-items="Html.GetEnumSelectList<OpenLearning.Gamification.Models.GamificationScopeKind>()"></select><input name="scopeId" maxlength="100" /><label><input name="hidden" type="checkbox" value="true" /> Hidden</label><input name="reason" maxlength="500" /><button>Update</button></form></section>
