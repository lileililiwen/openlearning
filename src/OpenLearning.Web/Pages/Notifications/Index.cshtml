@page
@model OpenLearning.Web.Pages.Notifications.IndexModel
@{
    ViewData["Title"] = "Notifications";
}

<div class="d-flex justify-content-between align-items-end mb-4">
    <div>
        <h1 class="h3 mb-1">Notifications</h1>
        <p class="text-muted mb-0">Updates from your courses and account.</p>
    </div>
    @if (Model.Items.Any(n => !n.IsRead))
    {
        <form method="post" asp-page-handler="MarkAllRead">
            <button type="submit" class="btn btn-outline-secondary btn-sm">Mark all as read</button>
        </form>
    }
</div>

@if (Model.Items.Count == 0)
{
    <div class="alert alert-info">You have no notifications yet.</div>
}
else
{
    <div class="list-group shadow-sm">
        @foreach (var item in Model.Items)
        {
            <div class="list-group-item @(item.IsRead ? "" : "bg-white")">
                <div class="d-flex justify-content-between align-items-center">
                    <div class="me-3">
                        <div class="fw-semibold @(item.IsRead ? "text-muted" : "")">
                            @if (!item.IsRead)
                            {
                                <span class="badge bg-primary me-1">New</span>
                            }
                            @item.Title
                        </div>
                        <div class="text-muted small">@item.Body</div>
                        <div class="text-muted small">@item.CreatedAt.ToString("yyyy-MM-dd HH:mm")</div>
                    </div>
                    @if (!item.IsRead)
                    {
                        <form method="post" asp-page-handler="Open" asp-route-id="@item.Id" class="ms-auto">
                            <button type="submit" class="btn btn-sm btn-outline-primary">Open</button>
                        </form>
                    }
                    else if (item.Link is not null)
                    {
                        <a class="btn btn-sm btn-outline-secondary ms-auto" href="@item.Link">View</a>
                    }
                </div>
            </div>
        }
    </div>
}
