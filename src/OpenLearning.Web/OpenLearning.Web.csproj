<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- S8970: the compiler requires null-forgiving operators in Razor views
         (the generated page Model is nullable-annotated), so Sonar's rule that
         they are redundant can never be satisfied here. Suppressed project-wide. -->
    <NoWarn>$(NoWarn);S8970</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="8.0.30" />
    <ProjectReference Include="..\OpenLearning.Data\OpenLearning.Data.csproj" />
    <PackageReference Include="Markdig" Version="0.37.0" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="8.0.30" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.30">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenLearning.Assessments\OpenLearning.Assessments.csproj" />
    <ProjectReference Include="..\OpenLearning.Ecommerce\OpenLearning.Ecommerce.csproj" />
    <ProjectReference Include="..\OpenLearning.Scorm\OpenLearning.Scorm.csproj" />
    <ProjectReference Include="..\OpenLearning.Chat\OpenLearning.Chat.csproj" />
    <ProjectReference Include="..\OpenLearning.Ratings\OpenLearning.Ratings.csproj" />
    <ProjectReference Include="..\OpenLearning.Certificates\OpenLearning.Certificates.csproj" />
    <ProjectReference Include="..\OpenLearning.Notifications\OpenLearning.Notifications.csproj" />
    <ProjectReference Include="..\OpenLearning.Storage\OpenLearning.Storage.csproj" />
    <ProjectReference Include="..\OpenLearning.Logging\OpenLearning.Logging.csproj" />
    <ProjectReference Include="..\OpenLearning.SystemConfig\OpenLearning.SystemConfig.csproj" />
    <ProjectReference Include="..\OpenLearning.Memberships\OpenLearning.Memberships.csproj" />
    <ProjectReference Include="..\OpenLearning.Operations\OpenLearning.Operations.csproj" />
    <ProjectReference Include="..\OpenLearning.Assignments\OpenLearning.Assignments.csproj" />
    <ProjectReference Include="..\OpenLearning.StudyTools\OpenLearning.StudyTools.csproj" />
  </ItemGroup>

</Project>
